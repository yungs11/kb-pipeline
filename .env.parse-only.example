# 8.kb-pipeline/.env.parse-only.example — 파서 전용(parse-only) 배포용 키 카탈로그
# ─────────────────────────────────────────────────────────────────────────────
# 대상: scripts/airgap/parse-only-up.sh 가 올리는 5개 서비스
#       postgres · minio · parse-svc · facade · facade-worker
#       (edgequake / adaptive_chunk / webui / doc_guard 는 안 뜬다 → 관련 키 전부 불필요)
#
# 사용법:
#   cp .env.parse-only.example <번들루트>/.env      # 파일명은 반드시 .env
#   vi <번들루트>/.env                              # ▣ 표시된 값만 채우면 된다
#   ./scripts/airgap/parse-only-up.sh
#
# ⚠️ 이 파일은 git 추적 대상이다. **실제 키를 여기 적지 말 것.**
#    실값이 채워진 사본은 .env.parse-only (gitignored) 에 있다.
#
# ⚠️ docker-compose 의 env 파서는 인라인 주석을 걷어내지 않는다.
#    `KEY=value  # 설명` 으로 쓰면 "value  # 설명" 전체가 값이 된다. 주석은 반드시 윗줄에.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════
# 1. 필수 — 안 채우면 기동 실패하거나 파싱이 전부 죽는다
# ═══════════════════════════════════════════════════════════════════════════

# ── 1-1. 내부 인프라 크레덴셜 ────────────────────────────────────────────────
# 스택 내부에서만 쓰는 값이라 아무 문자열이나 가능하다. 다만 minio 콘솔(호스트 3003)이
# 외부에 노출되므로 기본값 그대로 두지 말 것.
# ▣
MINIO_ACCESS_KEY=
# ▣
MINIO_SECRET_KEY=
MINIO_BUCKET=document-parser
# ▣
POSTGRES_PASSWORD=

# 컨테이너 내부 DNS. 외부 S3/MinIO 로 뺄 때만 바꾼다(그 경우 MINIO_SECURE=true).
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# ── 1-2. facade 공유비밀 ────────────────────────────────────────────────────
# facade 가 호스트 포트(3000)로 노출되므로 반드시 채운다.
# **비워두면 인증 게이트가 꺼져 누구나 /parse 를 호출할 수 있다.**
# 호출측(배치 스크립트 등)이 X-Facade-Key 헤더에 같은 값을 실어야 한다.
#   생성 예: openssl rand -hex 32
# ▣
KBP_FACADE_KEY=

# ── 1-3. VL(Vision-Language) OCR — 스캔 PDF·이미지 페이지 ────────────────────
# parse_service/parsers/ocr/vl_api.py 가 직접 읽는다.
# MODEL_NAME 은 compose 에서 `:?` (필수) 라 **비어 있으면 스택이 아예 안 뜬다.**
# ▣
MODEL_API_URL=
# ▣
MODEL_API_KEY=
# ▣
# ⚠️ compose 가 `${MODEL_NAME:?}` 로 **강제**한다 — 비우면 parse-svc 가 아예 안 뜬다.
#    VL 성능이 모델에 크게 좌우된다(122b vs 235b 실측 차이 큼) — 온프렘 서빙 모델명을 정확히.
MODEL_NAME=qwen/qwen3.5-122b-a10b
# 큰 표의 VL 응답 JSON 잘림 방지. 기본 2000 이면 잘려서 plain-text 로 폴백한다.
VL_MAX_TOKENS=8000

# ── 1-4. LLM (facade/parse-svc 보조 호출) ───────────────────────────────────
# ▣
KBP_OPENAI_API_KEY=
# ▣
KBP_OPENAI_BASE_URL=
# ▣
KBP_LLM_MODEL=


# ═══════════════════════════════════════════════════════════════════════════
# 2. 스캔 PDF OCR 게이트웨이 (paddle_gw 레인)
# ═══════════════════════════════════════════════════════════════════════════
# ⚠️ 아래 KBP_GATE_OCR_LANE 이 paddle_gw 인데 이 URL 이 비어 있으면,
#    스캔 문서가 paddle_gw 로 보내진 뒤 RuntimeError 로 실패하고
#    **조용히 ODL/VL 로 폴백한다**(비치명 처리라 에러가 겉으로 안 보인다).
#    파싱은 "성공"으로 보이지만 의도한 스캔 레인은 한 번도 동작하지 않는다.
#    게이트웨이를 안 쓸 거면 KBP_GATE_OCR_LANE 을 vl 로 바꿔 명시적으로 끈다.
# ▣
KBP_PADDLE_OCR_GATEWAY_URL=
KBP_PADDLE_GW_LANG=korean
KBP_PADDLE_GW_DPI=150
# 문서 1건 전체 타임아웃(초)
KBP_PADDLE_GW_TIMEOUT=600
# 개별 HTTP 요청 타임아웃(초)
KBP_PADDLE_GW_HTTP_TIMEOUT=60
# 비동기 task 폴링 간격(초)
KBP_PADDLE_GW_POLL_INTERVAL=5
# 게이트웨이로 동시에 보낼 페이지 수. 게이트웨이 처리량에 맞춘다.
# ⚠️ 변수명 주의 — paddle_gw 는 KBP_PADDLE_GW_MAX_CONCURRENT 가 아니라 이 값을 읽는다
# (paddle_gw.py:143, 미설정 시 3). VL 레인과 공유하는 동시성 노브다.
# 코드/compose 기본값은 3 이지만 8 로 올려 쓴다(사용자 지정, 2026-08-09).
# 게이트웨이가 밀리면(타임아웃·5xx 증가) 낮춘다.
KBP_VL_MAX_CONCURRENT=8
# ⚠️ 빈 값으로 두지 마라 — 미설정과 정반대(reasoning 켬)로 동작한다(vl_api.py).
KBP_VL_DISABLE_REASONING=1


# ═══════════════════════════════════════════════════════════════════════════
# 3. 선택 — 사내 문서 변환 / DRM 해제 API
# ═══════════════════════════════════════════════════════════════════════════
# 안 채우면 해당 기능만 비활성. 나머지 파싱은 정상 동작한다.

# ── 3-1. 파일 변환 (hwp/hwpx 등 → 표준 포맷) ────────────────────────────────
KBP_FILECONVERT_URL=
KBP_FILECONVERT_TOKEN=
KBP_FILECONVERT_TIMEOUT=300
# 호출 주체 식별자. 서버측 로그/쿼터 구분용.
KBP_FILECONVERT_CRT_ID=kb-pipeline

# ── 3-2. DRM 해제 (Fasoo) ──────────────────────────────────────────────────
# 미설정 시 DRM 문서(선두 32바이트에 DRMONE 매직)는 파싱 실패로 떨어진다.
KBP_DRM_URL=
KBP_DRM_TOKEN=
KBP_DRM_TIMEOUT=300


# ═══════════════════════════════════════════════════════════════════════════
# 4. PDF 레인 판정(트리아제) — 기본값이 실측 튜닝값. 건드리지 말 것 권장
# ═══════════════════════════════════════════════════════════════════════════
# 어떤 PDF 를 어느 파서로 보낼지 결정한다. 파싱 품질이 통째로 달라진다.

# 페이지의 이미지 커버리지가 이 비율 이상이면 혼합(mixed) 페이지로 본다.
KBP_TRIAGE_MIXED_IMAGE_COV=0.25
# 네이티브 텍스트가 이 글자수 미만이면 스캔으로 본다.
KBP_TRIAGE_CONTENT_MIN=300
KBP_TRIAGE_NATIVE_TEXT_MIN_CHARS=20
# 도형/차트 판정 임계치
KBP_TRIAGE_DIAGRAM_CURVE_MIN=30
KBP_TRIAGE_DIAGRAM_LINE_MIN=100
KBP_TRIAGE_DIAGRAM_IMG_COUNT=5
KBP_TRIAGE_DIAGRAM_COMBO_CURVE_MIN=10
# 가로 페이지를 LLM 레인으로 보낼지(1=보냄)
KBP_TRIAGE_LANDSCAPE_TO_LLM=1
# 판정 근거를 로그 테이블로 출력(1=출력). 품질 조사 시 유용.
KBP_TRIAGE_LOG_TABLE=1

# ── 레인 배정 ───────────────────────────────────────────────────────────────
# 시각요소 비율이 이 값 이상이면 VL 레인
# ⚠️ 무효(2026-08-12) — 페이지수준 라우팅 도입으로 **소비자가 사라졌다**.
#    문서수준 `vl` 레인이 없어져 값을 바꿔도 아무 일도 안 일어난다.
#    선언만 남긴 이유: 지우지도 설명하지도 않으면 다음 사람이 값을 바꿔보고
#    아무 변화가 없는 것을 겪는다. 삭제는 Phase 4(현장 .env 마이그레이션 동반).
KBP_GATE_VL_RATIO=0.5
KBP_GATE_VL_LANE=vl
# 스캔 판정 시 레인. paddle_gw 로 두려면 위 2절의 URL 을 반드시 채운다.
KBP_GATE_OCR_LANE=paddle_gw

# ── VL 프로바이더 차단 (parse_service/parsers/ocr/vl_api.py) ──
# OpenRouter 전용 필드라 **자체 서빙에서는 무의미**하다. 끄기는 `none` 센티널을 쓴다 —
# 빈 값은 sync-parse-svc-env.sh 가 통째로 버려 키가 안 실리고 코드 기본값(DeepInfra)이
# 부활한다. ⚠️ airgap compose 는 값을 하드코딩하므로 컨테이너 경로엔 실효가 없다 —
# 이 값은 호스트/parse-only 경로용이다.
KBP_VL_BLOCK_PROVIDERS=none


# ── paddle_gw 페이지 게이트 (parse_service/parsers/pdf/page_verdict.py, 2026-08-11) ──
# GW 출력이 **확실히 붕괴한 페이지만** quarantine 한다(색인 제외 + 사유 보존).
# 애매하면 보존이 원칙 — false quarantine 보다 silent deletion 이 더 나쁘다.
# 값에 인라인 주석을 붙이지 말 것(순진한 파서가 주석까지 값으로 읽는다).
#
# KBP_GW_GATE                0 = 게이트 전체 off (탈출구)
# KBP_GW_MIN_CHARS           이보다 적으면 EMPTY 후보
# KBP_GW_BLANK_INK_MAX       잉크가 이 미만이면 '원래 빈 페이지'(실패 아님, 색인 유지)
# KBP_GW_CJK_MIN             한자 오염 판정 하한(자)
# KBP_GW_CJK_RATIO           한자/(한자+한글) 비율
# KBP_GW_CJK_DOC_RATIO       문서의 이 비율 이상이 한자오염이면 '한자 문서'로 보고 되돌림
# KBP_GW_CJK_DOC_MIN_PAGES   위 문서 가드의 최소 페이지 수(1~2p 문서 자기무력화 방지)
# KBP_GW_DEGEN_SURVIVE_RATIO 퇴화 제거 후 잔존율이 이 미만이면 붕괴
# KBP_GW_DEGEN_MIN_CHARS     원문이 이보다 짧으면 붕괴 판정 안 함(짧은 페이지 증폭 방지)
KBP_GW_GATE=1
KBP_GW_MIN_CHARS=50
KBP_GW_BLANK_INK_MAX=0.05
KBP_GW_CJK_MIN=30
KBP_GW_CJK_RATIO=0.50
KBP_GW_CJK_DOC_RATIO=0.30
KBP_GW_CJK_DOC_MIN_PAGES=3
KBP_GW_DEGEN_SURVIVE_RATIO=0.5
KBP_GW_DEGEN_MIN_CHARS=500

# ── 퇴화 필터 (parse_service/parsers/degen_filter.py) — 전 레인 영향 ──
# KBP_DEGEN_COMPRESS_MAX  표 R1 압축비 임계(텍스트 T1 은 무변경)
# KBP_DEGEN_SOFT_RULES    SOFT 로 강등할 규칙. `none` 이면 전 규칙 HARD = 구동작 복원.
#                         ⚠️ 빈 값은 센티널이 아니다 — 미설정과 같이 기본값(R3,R4)이 된다.
KBP_DEGEN_COMPRESS_MAX=0.16
KBP_DEGEN_SOFT_RULES=R3,R4

# 그 외 기본 레인(네이티브 텍스트 PDF)
# ⚠️ 무효(2026-08-12) — 페이지수준 라우팅 도입으로 **소비자가 사라졌다**.
#    문서수준 `vl` 레인이 없어져 값을 바꿔도 아무 일도 안 일어난다.
#    선언만 남긴 이유: 지우지도 설명하지도 않으면 다음 사람이 값을 바꿔보고
#    아무 변화가 없는 것을 겪는다. 삭제는 Phase 4(현장 .env 마이그레이션 동반).
KBP_GATE_DEFAULT_LANE=odl

# ── VL 페이지 렌더링 ────────────────────────────────────────────────────────
KBP_VL_PAGE_DPI=200
KBP_VL_PAGE_MAX_TOKENS=8000
# image/figure/chart 가 페이지의 이 비율 이상일 때만 전면 VL
KBP_VL_VISUAL_MIN_AREA=0.05

# ── 프롬프트 오버라이드 (비우면 코드 기본값) ────────────────────────────────
# 계층구조(헤딩/표 병합셀/도형 상하위) 규칙 교체. 한 줄로 적는다.
KBP_PROMPT_HIERARCHY_RULE=
KBP_PAGE_HYBRID_DIAGRAM_RULE=


# ═══════════════════════════════════════════════════════════════════════════
# 5. 잡 큐 — 배치/대량처리 튜닝
# ═══════════════════════════════════════════════════════════════════════════
# 파서 전용 배포의 핵심 조정 지점. 서버 코어수/메모리에 맞춰 올린다.

# 동시 파싱 잡 수. CPU 코어수 기준으로 올린다(파싱이 CPU 바운드).
KBP_JOB_LIMIT_PARSE=4
# 워커 프로세스 동시성
KBP_JOB_WORKER_CONCURRENCY=4
# 한 워크스페이스가 동시에 점유할 수 있는 잡 수(한 사용자 독점 방지)
KBP_JOB_LIMIT_PER_WORKSPACE=2
# /parse 동기 호출이 결과를 기다리는 최대 대기자 수
KBP_JOB_MAX_WAITERS=4
# /parse 동기 호출 타임아웃(초). 대용량 스캔 PDF 는 오래 걸린다.
KBP_JOB_LEGACY_WAIT_SECONDS=3300
# 업로드 최대 크기(바이트). 기본 50MB.
KBP_JOB_MAX_UPLOAD_BYTES=52428800

# 청킹/적재 잡 — parse-only 에서는 해당 서비스가 안 떠서 사실상 미사용.
KBP_JOB_LIMIT_CHUNK=2
KBP_JOB_LIMIT_INSERT=2
KBP_JOB_LIMIT_COMMUNITY=1

# ── MinIO 오브젝트 수명 ────────────────────────────────────────────────────
KBP_JOB_MINIO_PREFIX=kbp-jobs
KBP_STAGING_PREFIX=parse-staging
# 미리보기 임시본 TTL(초)
KBP_STAGING_TTL_SECONDS=3600
# 배치 원본 TTL(초). 실패 항목 재수행이 이 객체를 다시 쓰므로 길게. 기본 7일.
KBP_STAGING_BATCH_TTL_SECONDS=604800

# ── GC ─────────────────────────────────────────────────────────────────────
# 0 이면 TTL 삭제와 고아 스윕이 **둘 다 정지**한다(비상 레버).
KBP_JOB_TTL_HOURS=72
KBP_JOB_GC_INTERVAL_SECONDS=3600
KBP_JOB_ORPHAN_SWEEP_INTERVAL_SECONDS=21600
KBP_JOB_ORPHAN_SWEEP_BOOT_DELAY_SECONDS=600
KBP_JOB_ORPHAN_GRACE_SECONDS=21600

# ── global 검색 (B) — **파서 전용 배포에서는 비활성** ────────────────────────
# 파서 전용 스택에는 edgequake·커뮤니티 리포트가 아예 없어 global 검색이 무의미하다.
# 0 이면 슬롯을 하나도 못 잡아 즉시 503 이 된다(LLM 을 태우지 않는다).
KBP_GLOBAL_SEARCH_CONCURRENCY=0
KBP_GLOBAL_LLM_TIMEOUT=60

# ── 야간 커뮤니티 배치 (A1) — **파서 전용 배포에서는 끈다** ──────────────────
# parse-only-up.sh 는 facade-worker 를 전체 스택과 **같은 env 앵커**로 띄운다. 그래서
# 아무것도 안 하면 이 배포에도 야간 스레드가 떠서, 매 밤 **존재하지 않는 edgequake** 를
# 호출하고 실패 로그를 쌓는다. 파서 전용은 커뮤니티를 쓰지 않으므로 끄는 것이 기본이다.
# (parse-only-up.sh 가 이 값을 강제로 덮어쓰지만, 여기에도 명시해 의도를 남긴다.)
KBP_COMMUNITY_BUILD_ENABLED=false
# 야간 창 판정용(컨테이너 TZ 아님 — D33). 이 배포는 배치를 끄므로 무의미하지만
# 앵커 공유라 값은 전달된다. 비워도 기본값 Asia/Seoul.
KBP_COMMUNITY_TZ=Asia/Seoul

# ── edgequake 하드스톱 (P1 2026-08-10) ────────────────────────────────────────
# ⚠️ **이 배포에서는 절대 1 로 두지 마라.** 파서 전용 스택에는 edgequake 가 아예 없어서
#    1 이면 facade 가 기동을 거부하고 /parse 접수까지 막힌다. 0(기본)이면 경고만 찍고
#    parse/chunk/gate 는 정상 동작한다.
KBP_REQUIRE_EDGEQUAKE=0
