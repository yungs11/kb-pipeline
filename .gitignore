# OS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
.venv-kb/
# 워크트리에서 메인의 venv 를 심볼릭 링크로 쓰는 경우 — 디렉터리 패턴에 안 걸린다
.venv-kb
.venv
.venv*/
venv/
.env
*.egg-info/
.pytest_cache/

# Logs / tmp
*.log
*.tmp

# Service launcher secrets (KBP_* env incl. OpenRouter key) — never commit
scripts/*.env

# Worktrees (git worktree 기본 위치 — 추적 금지)
.worktrees/

# Node tooling (if any)
node_modules/

# Large binary test corpus (track via git-lfs if needed)
test_doc/

# host-specific port remaps (local only)
docker-compose.override.yml

# 실값이 채워진 배포용 env (실키 포함) — .example 템플릿만 추적한다.
# 단일 파일명(.env.parse-only)으로 넣었더니 지워진 적이 있어(2026-08-09) 패턴으로 둔다.
# 새 배포 프로파일(.env.<무엇>)이 생겨도 자동으로 보호된다.
.env.*
!.env.example
!.env.*.example

# secret-bearing env backups (never commit)
# ★ 구분자가 두 종류다 — 하이픈(`bak-`)만 막아뒀더니 sync-parse-svc-env.sh 가 쓰는
#   점 형태(`.env.bak.134521`)가 그대로 추적 대상으로 떴다(실측 2026-08-10).
#   루트 `.env.bak.*` 는 위 `.env.*` 에 걸려 우연히 막혔지만 `scripts/` 아래는 뚫렸다.
scripts/*.env.bak-*
scripts/*.env.bak.*
*.env.bak-*
*.env.bak.*
.env.bak-*
.env.bak.*

# 폐쇄망 번들 산출물 — 7GB+ 이미지 tar 와 분할 파트. 재생성 가능(scripts/airgap/build-bundle.sh).
dist/
.venv-kb

# postgres 백업 덤프(scripts/airgap/pg-backup.sh) — 실제 문서 메타데이터가 들어갈 수 있다.
# 커밋 금지, 저장소 밖(현장 배포 디렉터리)에 남긴다.
backups/

# Claude Code worktrees (격리 작업공간 — 리포에 커밋되면 안 된다)
.claude/worktrees/
