# parse-svc 호스트 dev env 템플릿 — 복사해 `scripts/parse-svc.env` 로 쓴다.
# **시크릿 값을 이 파일에 적지 마라**(.example 은 tracked, 실 파일은 .gitignore:20 대상).
KBP_OPENAI_API_KEY=
KBP_OPENAI_BASE_URL=
KBP_LLM_MODEL=
MODEL_API_URL=
MODEL_API_KEY=
VL_MAX_TOKENS=8000
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_SECURE=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
KBP_PADDLE_OCR_GATEWAY_URL=
KBP_PADDLE_GW_MAX_CONCURRENT=8
KBP_VL_MAX_CONCURRENT=3
# 파일 변환 API — URL 은 경로 접두사까지(.../api/fileconvert/agent/tool)
KBP_FILECONVERT_URL=
KBP_FILECONVERT_TOKEN=
KBP_FILECONVERT_TIMEOUT=300
KBP_FILECONVERT_CRT_ID=kb-pipeline
