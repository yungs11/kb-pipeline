# parse-svc 호스트 dev env 템플릿 — 복사해 `scripts/parse-svc.env` 로 쓴다.
# **시크릿 값을 이 파일에 적지 마라**(.example 은 tracked, 실 파일은 .gitignore:20 대상).
KBP_OPENAI_API_KEY=
KBP_OPENAI_BASE_URL=
KBP_LLM_MODEL=
MODEL_API_URL=
MODEL_API_KEY=
VL_MAX_TOKENS=8000
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_SECURE=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
KBP_PADDLE_OCR_GATEWAY_URL=http://15.164.81.29:18081/ocr/paddleocr_vl
# ⚠️ 예전에 여기 KBP_PADDLE_GW_MAX_CONCURRENT 를 적어뒀는데 **코드가 읽지 않는 죽은
# 변수**였다(2026-08-09 확인). paddle_gw.py:143 은 아래 값을 읽는다(미설정 시 3).
# VL 레인과 공유하는 노브다 — 게이트웨이 처리량에 맞춰 올린다.
KBP_VL_MAX_CONCURRENT=8
# 파일 변환 API — URL 은 경로 접두사까지(.../api/fileconvert/agent/tool)
KBP_FILECONVERT_URL=http://13.209.146.36/api/fileconvert/agent/tool
KBP_FILECONVERT_TOKEN=
KBP_FILECONVERT_TIMEOUT=300
KBP_FILECONVERT_CRT_ID=kb-pipeline
# DRM 해제 API — URL 은 경로 접두사까지(.../api/drm/agent/tool). 토큰은 별도 변수(값은 우선 동일).
KBP_DRM_URL=http://13.209.146.36/api/drm/agent/tool
KBP_DRM_TOKEN=
KBP_DRM_TIMEOUT=300
# PDF 트리아제 임계치(고도화 준비, 2026-08-06) — 미설정 시 기존 하드코딩 값과 동일.
KBP_TRIAGE_MIXED_IMAGE_COV=0.25
KBP_TRIAGE_CONTENT_MIN=300
KBP_TRIAGE_DIAGRAM_CURVE_MIN=30
KBP_TRIAGE_DIAGRAM_LINE_MIN=100
KBP_TRIAGE_DIAGRAM_IMG_COUNT=5
KBP_TRIAGE_DIAGRAM_COMBO_CURVE_MIN=10
KBP_TRIAGE_NATIVE_TEXT_MIN_CHARS=20
KBP_TRIAGE_LANDSCAPE_TO_LLM=1
# PDF 게이트 — 레인 선택(odl|vl|paddle_gw 만 유효).
# ⚠️ 무효(2026-08-12) — 페이지수준 라우팅 도입으로 **소비자가 사라졌다**.
#    문서수준 `vl` 레인이 없어져 값을 바꿔도 아무 일도 안 일어난다.
#    선언만 남긴 이유: 지우지도 설명하지도 않으면 다음 사람이 값을 바꿔보고
#    아무 변화가 없는 것을 겪는다. 삭제는 Phase 4(현장 .env 마이그레이션 동반).
KBP_GATE_VL_RATIO=0.5
KBP_GATE_VL_LANE=vl
KBP_GATE_OCR_LANE=paddle_gw

# ── VL 프로바이더 차단 (parse_service/parsers/ocr/vl_api.py) ──
# OpenRouter 가 같은 모델을 여러 업체에 분산시키는데 일부가 **이미지를 조용히 버리고**
# 텍스트만으로 환각한다(실측: qwen3.5-122b 의 DeepInfra 가 prompt_tokens=42 로 이미지 폐기).
# 거부가 아니라 조용한 환각이라 상류에서 검출이 불가능하다.
#   미설정 → DeepInfra 차단 / 빈 값·none·off → 끄기
# dev 는 OpenRouter 를 경유하므로 이 방어가 필요한 유일한 환경이다 — 끄지 말 것.
KBP_VL_BLOCK_PROVIDERS=DeepInfra

# ── 페이지수준 라우팅 · VL 전사(2026-08-12 Phase 2a) ──────────────────────────
# 스캔 페이지 게이트웨이 렌더 DPI. 300 이상은 호출 비용이 급증한다.
KBP_PADDLE_GW_DPI=150
# VL 전사 페이지 렌더 DPI / 응답 상한. 상한이 낮으면 조밀한 본문이 절단된다
# (2026-08-04 실측: 2526자 페이지가 기본 2000 으로 빈 페이지가 됐다).
KBP_VL_PAGE_DPI=200
KBP_VL_PAGE_MAX_TOKENS=8000
# hybrid 판정 면적 임계 — layout 이 잡은 그림/차트가 페이지의 이 비율 이상이면 전면 VL.
KBP_VL_VISUAL_MIN_AREA=0.05
# VL 동시 호출 수 = 게이트웨이 동시 POST 수. 현장 GPU 부하에 직결된다.
# ⚠️ **빈 값으로 두지 마라 — 미설정과 정반대로 동작한다.**
#    vl_api.py 는 `os.environ.get(..., "1") not in ("0","false","off","")` 로 읽는다.
#    미설정 = "1" = reasoning 끔(원하는 기본). 빈 값 = reasoning **켬** → VL 응답이
#    느려지고 절단된다. 폐쇄망 compose 에서만 새는 유형이라 반드시 1 을 명시한다.
KBP_VL_DISABLE_REASONING=1



# VL 모델명 — **필수**. 코드에 암묵 기본값이 없다(미설정이면 VL 호출이 RuntimeError).
# 2026-08 사고: 여기에 선언이 없어 호스트 dev 가 코드 기본값 235b 로 조용히 샜다.
MODEL_NAME=qwen/qwen3.5-122b-a10b

# ── paddle_gw 페이지 게이트 (parse_service/parsers/pdf/page_verdict.py, 2026-08-11) ──
# GW 출력이 **확실히 붕괴한 페이지만** quarantine 한다(색인 제외 + 사유 보존).
# 애매하면 보존이 원칙 — false quarantine 보다 silent deletion 이 더 나쁘다.
# 값에 인라인 주석을 붙이지 말 것(순진한 파서가 주석까지 값으로 읽는다).
#
# KBP_GW_GATE                0 = 게이트 전체 off (탈출구)
# KBP_GW_MIN_CHARS           이보다 적으면 EMPTY 후보
# KBP_GW_BLANK_INK_MAX       잉크가 이 미만이면 '원래 빈 페이지'(실패 아님, 색인 유지)
# KBP_GW_CJK_MIN             한자 오염 판정 하한(자)
# KBP_GW_CJK_RATIO           한자/(한자+한글) 비율
# KBP_GW_CJK_DOC_RATIO       문서의 이 비율 이상이 한자오염이면 '한자 문서'로 보고 되돌림
# KBP_GW_CJK_DOC_MIN_PAGES   위 문서 가드의 최소 페이지 수(1~2p 문서 자기무력화 방지)
# KBP_GW_DEGEN_SURVIVE_RATIO 퇴화 제거 후 잔존율이 이 미만이면 붕괴
# KBP_GW_DEGEN_MIN_CHARS     원문이 이보다 짧으면 붕괴 판정 안 함(짧은 페이지 증폭 방지)
KBP_GW_GATE=1
KBP_GW_MIN_CHARS=50
KBP_GW_BLANK_INK_MAX=0.05
KBP_GW_CJK_MIN=30
KBP_GW_CJK_RATIO=0.50
KBP_GW_CJK_DOC_RATIO=0.30
KBP_GW_CJK_DOC_MIN_PAGES=3
KBP_GW_DEGEN_SURVIVE_RATIO=0.5
KBP_GW_DEGEN_MIN_CHARS=500

# ── 퇴화 필터 (parse_service/parsers/degen_filter.py) — 전 레인 영향 ──
# KBP_DEGEN_COMPRESS_MAX  표 R1 압축비 임계(텍스트 T1 은 무변경)
# KBP_DEGEN_SOFT_RULES    SOFT 로 강등할 규칙. `none` 이면 전 규칙 HARD = 구동작 복원.
#                         ⚠️ 빈 값은 센티널이 아니다 — 미설정과 같이 기본값(R3,R4)이 된다.
KBP_DEGEN_COMPRESS_MAX=0.16
KBP_DEGEN_SOFT_RULES=R3,R4

# ⚠️ 무효(2026-08-12) — 페이지수준 라우팅 도입으로 **소비자가 사라졌다**.
#    문서수준 `vl` 레인이 없어져 값을 바꿔도 아무 일도 안 일어난다.
#    선언만 남긴 이유: 지우지도 설명하지도 않으면 다음 사람이 값을 바꿔보고
#    아무 변화가 없는 것을 겪는다. 삭제는 Phase 4(현장 .env 마이그레이션 동반).
KBP_GATE_DEFAULT_LANE=odl
# 페이지별 판정 로그 on/off.
KBP_TRIAGE_LOG_TABLE=1
# PAGE_HYBRID 프롬프트의 순서도 조항 전체를 교체(선택, 비워두면 코드 기본값 — 박스 안
# 라벨을 원문 그대로 보존하며 흐름을 서술하는 규칙 — 사용). dotenv 는 여러 줄 값을 지원하지
# 않으므로 **줄바꿈 없이 한 줄**로 적는다(모델은 프롬프트 줄바꿈 여부에 개의치 않는다).
KBP_PAGE_HYBRID_DIAGRAM_RULE=
# VL 프롬프트 — 계층구조(헤딩#/표 병합셀 colspan·rowspan/도형 상하위·단계) 규칙 전체를
# 교체(선택, 비워두면 코드 기본값). 실측 2026-08-07: 미적용 시 VL 이 마크다운 헤딩을
# 33/33 페이지에서 전혀 안 내 RAG 청킹 시 장·절 계층이 사라졌다. 한 줄로 적는다.
KBP_PROMPT_HIERARCHY_RULE=
