# 8.kb-pipeline/.env.example — key catalog for docker-compose.yml
# Copy to .env and fill real values. .env is gitignored — NEVER commit it.
# Real secrets stay blank here. Safe non-secret defaults are shown where applicable.

# ---------------------------------------------------------------------------
# OpenRouter — edgequake LLM + facade/parse-svc LLM
# ---------------------------------------------------------------------------
# EDGEQUAKE_LLM_PROVIDER default stays "openrouter" (docker-compose.yml) — set to
# "openai-compatible" here to redirect edgequake's chat LLM to KBP_OPENAI_* instead.
# airgap 실측(2026-08-07): openrouter has no base_url override (hardcoded
# https://openrouter.ai); plain "openai" provider silently downgrades non-gpt-*
# model names via COMPAT-GUARD (safety_limits.rs) back to api.openai.com —
# "openai-compatible" is exempt from that guard, use it instead.
EDGEQUAKE_LLM_PROVIDER=
OPENROUTER_API_KEY=
# parse-svc + facade LLM key (OpenRouter or litellm proxy). docker-compose 의 env-file
# 파서는 인라인 주석(값 뒤 " # ...")을 지원하지 않는다 — 값에 그대로 섞여 들어간다.
# 실측(2026-08-07): 이 줄에 인라인 주석이 있어 KBP_OPENAI_API_KEY 가 빈 문자열이 아니라
# 주석 텍스트 자체로 치환됐었다. 주석은 반드시 별도 줄에 둔다.
KBP_OPENAI_API_KEY=
KBP_OPENAI_BASE_URL=https://openrouter.ai/api/v1
KBP_LLM_MODEL=qwen/qwen3.5-122b-a10b

# ---------------------------------------------------------------------------
# litellm proxy — BGE-M3 embeddings (edgequake)
# ---------------------------------------------------------------------------
LITELLM_EMBEDDING_API_KEY=
LITELLM_EMBEDDING_BASE_URL=https://litellm.ax-demo.com/v1

# ---------------------------------------------------------------------------
# VL model — parse-svc in-process OCR (vision-language backend)
# ---------------------------------------------------------------------------
MODEL_API_URL=
MODEL_API_KEY=

# ---------------------------------------------------------------------------
# MinIO — parse-svc + facade
# ---------------------------------------------------------------------------
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=document-parser

# ---------------------------------------------------------------------------
# Postgres — edgequake graph DB
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=edgequake_secret

# ---------------------------------------------------------------------------
# adaptive_chunk — all 16 ADAPTIVE_CHUNK_* keys (env_prefix="ADAPTIVE_CHUNK_")
# Do NOT use env_file: in compose — each key is listed explicitly to avoid leaking secrets.
# ---------------------------------------------------------------------------

# OpenRouter API key for adaptive_chunk LLM calls (regex/coref/scoring)
ADAPTIVE_CHUNK_OPENROUTER_API_KEY=

# OpenRouter base URL
ADAPTIVE_CHUNK_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Scoring embedding model (e.g. bge-m3)
ADAPTIVE_CHUNK_SCORING_EMBEDDING_MODEL=bge-m3

# Scoring embedding endpoint — must be reachable FROM INSIDE the container.
# localhost:8899 or localhost:7997 are unreachable in-container.
# Use the remote litellm URL: https://litellm.ax-demo.com/v1
ADAPTIVE_CHUNK_SCORING_EMBEDDING_BASE_URL=https://litellm.ax-demo.com/v1

ADAPTIVE_CHUNK_SCORING_EMBEDDING_API_KEY=

# Per-call HTTP timeout for scoring embedding (seconds). Generous for large document batches.
ADAPTIVE_CHUNK_SCORING_EMBEDDING_TIMEOUT_S=600

# LLM model for regex/evaluation step (OpenRouter)
ADAPTIVE_CHUNK_REGEX_LLM_MODEL=qwen/qwen3.5-122b-a10b

# OCR backend — 제거(Phase 2e). adaptive 의 file-OCR 경로 전용이었고 facade 는 text
# 경로(/chunk/jobs)만 사용 → document-parser 제거와 함께 삭제. file-OCR 필요 시 재도입.

# Edgequake base URL — if adaptive_chunk needs to call edgequake, use intra-stack DNS:
# http://edgequake:8081
# The host value (localhost:8899 or localhost:8081) is unreachable in-container.
ADAPTIVE_CHUNK_EDGEQUAKE_BASE_URL=http://edgequake:8081

# Job-level timeout (seconds)
ADAPTIVE_CHUNK_JOB_TIMEOUT_S=1200

# Reranker model (e.g. Qwen3-Reranker-0.6B via litellm)
ADAPTIVE_CHUNK_RERANK_MODEL=Qwen3-Reranker-0.6B

# Reranker endpoint — must be reachable FROM INSIDE the container.
# Use remote litellm URL: https://litellm.ax-demo.com/v1
ADAPTIVE_CHUNK_RERANK_BASE_URL=https://litellm.ax-demo.com/v1

ADAPTIVE_CHUNK_RERANK_API_KEY=

# Coreference LLM model (used for RC scoring)
ADAPTIVE_CHUNK_COREF_LLM_MODEL=qwen/qwen3.5-122b-a10b

# Coreference reasoning toggle: 'off' = disabled (fast), 'on' = enabled (slow)
ADAPTIVE_CHUNK_COREF_REASONING=off

# ── 파일 변환 API (docs/API_FILECONVERT_AGENT.md) ─────────────────────────────
# URL 은 **경로 접두사까지** 포함한다. 호스트만 넣으면 404 로 조용히 실패한다.
# 아래 기본값은 **EC2 DEV 서버**다(개발 편의). 운영/폐쇄망에서는 반드시 사내 주소로 바꾼다
# — .env.airgap.example 은 일부러 비워 두어 미설정 시 즉시 실패하게 한다.
KBP_FILECONVERT_URL=http://13.209.146.36/api/fileconvert/agent/tool
KBP_FILECONVERT_TOKEN=
KBP_FILECONVERT_TIMEOUT=300
KBP_FILECONVERT_CRT_ID=kb-pipeline

# ── DRM 해제 API (docs/REFERENCE_DRM해제_API.md) ──────────────────────────────
# 같은 인프라지만 path prefix 가 다르다 — 예: http://<host>/api/drm/agent/tool
# 토큰은 별도 변수로 둔다(서버가 나중에 분리될 수 있음). 값은 우선 KBP_FILECONVERT_TOKEN 과 동일하게.
KBP_DRM_URL=http://13.209.146.36/api/drm/agent/tool
KBP_DRM_TOKEN=
KBP_DRM_TIMEOUT=300

# ── PDF 트리아제 임계치 (parse_service/parsers/pdf/triage.py, 2026-08-06) ──────
# 이미지 파서 고도화 준비 — 값을 바꾸면 소스 수정 없이 페이지 분류 임계치가 바뀐다.
# 미설정 시 기존 하드코딩 값과 100% 동일(회귀 0).
KBP_TRIAGE_MIXED_IMAGE_COV=0.25
KBP_TRIAGE_CONTENT_MIN=300
KBP_TRIAGE_DIAGRAM_CURVE_MIN=30
KBP_TRIAGE_DIAGRAM_LINE_MIN=100
KBP_TRIAGE_DIAGRAM_IMG_COUNT=5
KBP_TRIAGE_DIAGRAM_COMBO_CURVE_MIN=10
KBP_TRIAGE_NATIVE_TEXT_MIN_CHARS=20
# 가로형 페이지(width>height) → 묻고 따질 것 없이 LLM_NEEDED(VL). 0 이면 이 규칙을 끈다.
KBP_TRIAGE_LANDSCAPE_TO_LLM=1

# ── PDF 게이트 — 레인 선택 (parse_service/parsers/pdf/gate.py, 2026-08-06) ─────
# 값은 odl|vl|paddle_gw 중 하나만 유효(그 외는 경고 로그 + 기본값 폴백).
# ⚠️ 무효(2026-08-12) — 페이지수준 라우팅 도입으로 **소비자가 사라졌다**.
#    문서수준 `vl` 레인이 없어져 값을 바꿔도 아무 일도 안 일어난다.
#    선언만 남긴 이유: 지우지도 설명하지도 않으면 다음 사람이 값을 바꿔보고
#    아무 변화가 없는 것을 겪는다. 삭제는 Phase 4(현장 .env 마이그레이션 동반).
KBP_GATE_VL_RATIO=0.5
KBP_GATE_VL_LANE=vl
KBP_GATE_OCR_LANE=paddle_gw

# ── VL 프로바이더 차단 (parse_service/parsers/ocr/vl_api.py) ──
# OpenRouter 가 같은 모델을 여러 업체에 분산시키는데 일부가 **이미지를 조용히 버리고**
# 텍스트만으로 환각한다(실측: qwen3.5-122b 의 DeepInfra 가 prompt_tokens=42 로 이미지 폐기).
# 거부가 아니라 조용한 환각이라 상류에서 검출이 불가능하다.
#   미설정 → DeepInfra 차단 / 빈 값·none·off → 끄기
# dev 는 OpenRouter 를 경유하므로 이 방어가 필요한 유일한 환경이다 — 끄지 말 것.
KBP_VL_BLOCK_PROVIDERS=DeepInfra
# 게이트웨이 URL — 비면 paddle_gw 레인이 런타임에 불능이 되어 전 페이지 VL 폴백.
KBP_PADDLE_OCR_GATEWAY_URL=http://15.164.81.29:18081/ocr/paddleocr_vl

# ── 페이지수준 라우팅 · VL 전사(2026-08-12 Phase 2a) ──────────────────────────
# 스캔 페이지 게이트웨이 렌더 DPI. 300 이상은 호출 비용이 급증한다.
KBP_PADDLE_GW_DPI=150
# VL 전사 페이지 렌더 DPI / 응답 상한. 상한이 낮으면 조밀한 본문이 절단된다
# (2026-08-04 실측: 2526자 페이지가 기본 2000 으로 빈 페이지가 됐다).
KBP_VL_PAGE_DPI=200
KBP_VL_PAGE_MAX_TOKENS=8000
# ── VL 실패 정책 (Phase 2b-2, 2026-08-14) ──────────────────────────────────
# VL 이 끝내 아무것도 못 낸 페이지가 있으면 **문서 파싱을 실패**시킨다.
# 폴백(네이티브 텍스트·ODL 마크다운)은 제거됐다 — 122b 가 아픈데 다른 출처로
# 조용히 채워지면 열화를 볼 방법이 없기 때문이다.
KBP_VL_PAGE_ATTEMPTS=2          # 총 VL 호출 횟수(최초 1 + 재시도 1). 1~5 로 클램프
#   절단·에러플레이스홀더(A형)만 **+1회**를 더 받는다(기본 2 → 3). 원인이 모델 퇴화가
#   아니라 프로바이더 사정일 수 있어 재호출에서 살아나기 때문. 별도 env 없이 파생된다.
KBP_VL_DOC_BUDGET_S=3600        # 문서당 VL 총예산(초). 초과 시 남은 재시도 포기
# ⚠️ 탈출구. 0 으로 끄면 "이전 동작 복원"이 아니라 **빈 본문이 조용히 적재**된다
#    (폴백은 이미 삭제됐다). 그 대가를 알고 켤 것.
KBP_FAIL_ON_EMPTY_PAGE=1

# hybrid 판정 면적 임계 — layout 이 잡은 그림/차트가 페이지의 이 비율 이상이면 전면 VL.
KBP_VL_VISUAL_MIN_AREA=0.05
# VL 동시 호출 수 = 게이트웨이 동시 POST 수. 현장 GPU 부하에 직결된다.
KBP_VL_MAX_CONCURRENT=8
# ⚠️ **빈 값으로 두지 마라 — 미설정과 정반대로 동작한다.**
#    vl_api.py 는 `os.environ.get(..., "1") not in ("0","false","off","")` 로 읽는다.
#    미설정 = "1" = reasoning 끔(원하는 기본). 빈 값 = reasoning **켬** → VL 응답이
#    느려지고 절단된다. 폐쇄망 compose 에서만 새는 유형이라 반드시 1 을 명시한다.
KBP_VL_DISABLE_REASONING=1



# VL 모델명 — **필수**. 코드에 암묵 기본값이 없다(미설정이면 VL 호출이 RuntimeError).
# 2026-08 사고: 여기에 선언이 없어 호스트 dev 가 코드 기본값 235b 로 조용히 샜다.
MODEL_NAME=qwen/qwen3.5-122b-a10b

# ── paddle_gw 페이지 게이트 (parse_service/parsers/pdf/page_verdict.py, 2026-08-11) ──
# GW 출력이 **확실히 붕괴한 페이지만** quarantine 한다(색인 제외 + 사유 보존).
# 애매하면 보존이 원칙 — false quarantine 보다 silent deletion 이 더 나쁘다.
# 값에 인라인 주석을 붙이지 말 것(순진한 파서가 주석까지 값으로 읽는다).
#
# KBP_GW_GATE                0 = 게이트 전체 off (탈출구)
# KBP_GW_MIN_CHARS           이보다 적으면 EMPTY 후보
# KBP_GW_BLANK_INK_MAX       잉크가 이 미만이면 '원래 빈 페이지'(실패 아님, 색인 유지)
# KBP_GW_CJK_MIN             한자 오염 판정 하한(자)
# KBP_GW_CJK_RATIO           한자/(한자+한글) 비율
# KBP_GW_CJK_DOC_RATIO       문서의 이 비율 이상이 한자오염이면 '한자 문서'로 보고 되돌림
# KBP_GW_CJK_DOC_MIN_PAGES   위 문서 가드의 최소 페이지 수(1~2p 문서 자기무력화 방지)
# KBP_GW_DEGEN_SURVIVE_RATIO 퇴화 제거 후 잔존율이 이 미만이면 붕괴
# KBP_GW_DEGEN_MIN_CHARS     원문이 이보다 짧으면 붕괴 판정 안 함(짧은 페이지 증폭 방지)
KBP_GW_GATE=1
KBP_GW_MIN_CHARS=50
KBP_GW_BLANK_INK_MAX=0.05
KBP_GW_CJK_MIN=30
KBP_GW_CJK_RATIO=0.50
KBP_GW_CJK_DOC_RATIO=0.30
KBP_GW_CJK_DOC_MIN_PAGES=3
KBP_GW_DEGEN_SURVIVE_RATIO=0.5
KBP_GW_DEGEN_MIN_CHARS=500

# ── 퇴화 필터 (parse_service/parsers/degen_filter.py) — 전 레인 영향 ──
# KBP_DEGEN_COMPRESS_MAX  표 R1 압축비 임계(텍스트 T1 은 무변경)
# KBP_DEGEN_SOFT_RULES    SOFT 로 강등할 규칙. `none` 이면 전 규칙 HARD = 구동작 복원.
#                         ⚠️ 빈 값은 센티널이 아니다 — 미설정과 같이 기본값(R3,R4)이 된다.
KBP_DEGEN_COMPRESS_MAX=0.16
KBP_DEGEN_SOFT_RULES=R3,R4

# ⚠️ 무효(2026-08-12) — 페이지수준 라우팅 도입으로 **소비자가 사라졌다**.
#    문서수준 `vl` 레인이 없어져 값을 바꿔도 아무 일도 안 일어난다.
#    선언만 남긴 이유: 지우지도 설명하지도 않으면 다음 사람이 값을 바꿔보고
#    아무 변화가 없는 것을 겪는다. 삭제는 Phase 4(현장 .env 마이그레이션 동반).
KBP_GATE_DEFAULT_LANE=odl

# ── PDF 트리아제 페이지별 판정 로그 on/off (2026-08-06) ────────────────────────
# 0 이면 완전히 스킵(대량 처리 시 로그 폭주 억제).
KBP_TRIAGE_LOG_TABLE=1

# ── VL PAGE_HYBRID 프롬프트 — 순서도 조항 오버라이드 (parse_service/parsers/ocr/prompts.py, 2026-08-06) ──
# PAGE_HYBRID 프롬프트의 순서도 조항 전체를 교체(선택, 비워두면 코드 기본값 — 박스 안
# 라벨을 원문 그대로 보존하며 흐름을 서술하는 규칙 — 사용). dotenv 는 여러 줄 값을 지원하지
# 않으므로 **줄바꿈 없이 한 줄**로 적는다(모델은 프롬프트 줄바꿈 여부에 개의치 않는다).
KBP_PAGE_HYBRID_DIAGRAM_RULE=
# VL 프롬프트 — 계층구조(헤딩#/표 병합셀 colspan·rowspan/도형 상하위·단계) 규칙 전체를
# 교체(선택, 비워두면 코드 기본값). 실측 2026-08-07: 미적용 시 VL 이 마크다운 헤딩을
# 33/33 페이지에서 전혀 안 내 RAG 청킹 시 장·절 계층이 사라졌다. 한 줄로 적는다.
KBP_PROMPT_HIERARCHY_RULE=

# ── global 검색 (B) ───────────────────────────────────────────────────────────
# 커뮤니티 리포트 map-reduce 검색. 사용자가 챗에서 **명시적으로 버튼을 눌러** 쓴다
# (자동 라우팅 없음 — 오분류하면 조문 원문을 못 주는 답이 나온다).
# 요청 하나가 (map 최대 5 + reduce 1) × 타임아웃 만큼 스레드를 점유한다.
KBP_GLOBAL_LLM_TIMEOUT=60
# 워커 4개를 합친 **시스템 전역** 동시 실행 상한(DB 카운터 + advisory lock).
# 상한 도달 시 큐잉하지 않고 즉시 503 을 낸다.
KBP_GLOBAL_SEARCH_CONCURRENCY=2

# ── 야간 커뮤니티 배치 (A1) ───────────────────────────────────────────────────
# 커뮤니티 빌드를 적재 경로에서 떼어내 밤 1회로 모은다(주간 LLM 부하 회피 + 진입점 단일화).
# 대가: 커뮤니티가 **최대 하루** 뒤 반영된다. 즉시 필요하면 POST /communities/build.
# 야간 창을 판정할 시간대. **컨테이너 TZ 가 아니다**(D33) — 컨테이너는 UTC 로 둬서
# parse-svc 와 로그 시각축을 통일하고, 창 판정만 이 값으로 한다. 한 변수로 겸하면
# 로그를 UTC 로 맞추려 TZ=UTC 로 둘 때 **창이 조용히 KST 정오로 이동**한다.
# 비워도 된다 — 기본값이 Asia/Seoul 이다.
KBP_COMMUNITY_TZ=Asia/Seoul
KBP_COMMUNITY_BUILD_ENABLED=true
KBP_COMMUNITY_BUILD_AT=03:00
KBP_COMMUNITY_WINDOW_MINUTES=120
# 이 시각 이후 남은 queued 를 취소한다(업무시간 침범 방지). 창보다 커야 의미가 있다.
# ⚠️ 이미 실행 중(running)인 빌드는 자르지 않는다 — LLM 호출을 되돌릴 수 없어 작업만 버린다.
KBP_COMMUNITY_DEADLINE_MINUTES=420
KBP_COMMUNITY_MAX_PER_NIGHT=8
KBP_COMMUNITY_POLL_SECONDS=60
# SIGKILL/OOM 으로 실행 이력이 'started' 로 굳었을 때 회수하기까지의 지연(분).
KBP_COMMUNITY_STALE_RUN_MINUTES=30
# 제출 루프 시간 예산(초). edgequake 가 hang 이면 틱 하나가 오래 막히는 것을 끊는다.
KBP_COMMUNITY_SUBMIT_BUDGET_SECONDS=600

# ── 포트 탈출구 / edgequake 주소 (P1 2026-08-10) ──────────────────────────────
# facade 호스트 포트. **호스트 dev 런처(scripts/run-facade.sh) 전용**이다 —
# compose facade 는 3000:19000 으로 발행하므로 compose 쪽 충돌은 docker-compose.yml 을 고친다.
# ⚠️ 이 값을 바꾸면 kb 쪽 짝 env 도 같이 줘야 한다:
#    kb .env 의 KB_PIPELINE_BASE_URL=http://localhost:<이 포트>
#    (안 주면 kb→facade 적재·게이트가 조용히 끊긴다.)
KBP_FACADE_PORT=3000
# 1 이면 edgequake 에 닿지 않을 때 facade 기동을 **중단**한다. 기본(미설정/0)은 경고만 —
# facade 는 edgequake 없이도 /parse·/chunk·/gate/*·/objects/* 를 처리하므로 하드스톱을
# 기본으로 두면 parse 전용 작업이나 edgequake 재빌드 중 재기동을 막는다.
KBP_REQUIRE_EDGEQUAKE=0
# webui **브라우저**가 edgequake API 에 닿는 주소(호스트 포트). 원격 PC 에서 볼 때는
# localhost 가 아니라 서버 IP 를 줘야 한다 — 예) http://10.x.x.x:3001
EDGEQUAKE_WEBUI_API_URL=http://localhost:3001
