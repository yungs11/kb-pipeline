# 8.kb-pipeline/.env.airgap.example — 폐쇄망(air-gap) 배포용 환경변수 템플릿
# ═══════════════════════════════════════════════════════════════════════════════
# 사용법: 이 파일을 `.env` 로 복사한 뒤, 아래 【A. 온프렘 재설정 필수】 블록의
#         주소/키만 사내 엔드포인트로 바꾼다.
#             cp .env.airgap.example .env  &&  vi .env
#         【B. 내부 전용】 블록은 원칙적으로 건드리지 않는다.
#         모든 시크릿은 빈 값이다 — 반드시 실제 값으로 채워야 스택이 정상 기동한다.
#
# ⚠️ 규칙: 값 뒤에 인라인 주석(`KEY=값   # ...`)을 붙이지 말 것.
#          podman-compose 는 인라인 주석을 걷어내지 않아 그 `# ...` 가 값에 섞인다.
#          설명은 반드시 이렇게 '독립 라인'(`#` 으로 시작)에만 둔다.
# ═══════════════════════════════════════════════════════════════════════════════


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 【A. 온프렘 재설정 필수】 — 폐쇄망에서 도달 가능한 사내 주소/키로 바꿀 것        │
# │  ⚠️ 아래 BASE_URL 기본값은 전부 인터넷(OpenRouter/litellm.ax-demo.com)이라      │
# │     폐쇄망에서 불통이다. 반드시 사내 주소로 교체한다.                           │
# └─────────────────────────────────────────────────────────────────────────────┘

# ── A-1. LLM (그래프추출·facade·parse-svc·adaptive_chunk regex/coref) ──────────
#  무엇: 지식그래프 엔티티/관계 추출 + 답변합성 + 청킹 정규식/상호참조 LLM.
#  어디로: 사내 OpenAI 호환 LLM 게이트웨이(vLLM/litellm 등)의 /v1 주소.
#          *_BASE_URL 예) http://llm.internal.corp:8000/v1
#          *_LLM_MODEL 은 사내에서 실제 서빙하는 모델명으로.
#  안 바꾸면: edgequake 그래프추출·검색합성 타임아웃/실패, 청킹 스톨.
# ── A-0. facade 공유비밀 (X-Facade-Key) ───────────────────────────────────────
#  무엇: facade 의 상태변경 엔드포인트(/ingest·/insert·/search·/chunks·/doc·/jobs·
#        /gate·/objects)를 여는 공유비밀. **kb 스택의 KBP_FACADE_KEY 와 같은 값**이어야
#        적재·검색이 통과한다.
#  안 채우면: 게이트가 꺼진 채 기동한다(dev 와 동일 동작). 폐쇄망에서 facade 는 호스트
#        3000 포트로 노출되므로, 비워두면 **무인증으로 적재·검색·삭제가 열린다.**
#        verify-bundle.sh 가 배포 전에 막는다.
#  만들기: openssl rand -hex 32
KBP_FACADE_KEY=

# edgequake(그래프/벡터 엔진)의 LLM provider — 기본 openai-compatible(위 KBP_OPENAI_*
# 재사용, docker-compose.airgap.yml 의 OPENAI_COMPATIBLE_* 로 배선됨). 폐쇄망 실측
# (2026-08-07, 2단계):
#  1) openrouter provider 는 base_url 오버라이드가 없어 인터넷 없는 환경에서 100%
#     실패한다(하드코딩 https://openrouter.ai).
#  2) provider=openai 로 바꿔도 COMPAT-GUARD(safety_limits.rs)가 "openai"+비-gpt-*
#     모델명(예: qwen/...)을 감지해 gpt-4.1-nano/api.openai.com 으로 조용히 되돌린다.
#     openai-compatible 은 이 가드 대상이 아니라(코드 확인) 커스텀 모델명이 그대로 간다.
# 인터넷이 되는 환경에서만 openrouter 로 바꾼다.
EDGEQUAKE_LLM_PROVIDER=openai-compatible
OPENROUTER_API_KEY=
KBP_OPENAI_API_KEY=
KBP_OPENAI_BASE_URL=https://openrouter.ai/api/v1
KBP_LLM_MODEL=qwen/qwen3.5-122b-a10b
ADAPTIVE_CHUNK_OPENROUTER_API_KEY=
ADAPTIVE_CHUNK_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ADAPTIVE_CHUNK_REGEX_LLM_MODEL=qwen/qwen3.5-122b-a10b
ADAPTIVE_CHUNK_COREF_LLM_MODEL=qwen/qwen3.5-122b-a10b

# ── A-2. VL-OCR (parse-svc in-process 이미지/PPTX/스캔 파싱) ───────────────────
#  무엇: 이미지·스캔·PPTX 페이지를 텍스트로 푸는 비전-언어(VL) 모델.
#  어디로: 사내 VL 모델의 chat/completions 전체 경로.
#          MODEL_API_URL 예) http://vl.internal.corp:8000/v1/chat/completions
#  안 바꾸면: 이미지/PPTX/스캔 파싱 시 enriched_content 가 비어 적재 누락.
MODEL_API_URL=https://openrouter.ai/api/v1/chat/completions
MODEL_API_KEY=

# ── A-3. 임베딩 (edgequake 벡터화 + adaptive_chunk 스코어링, bge-m3, 1024차원) ──
#  무엇: 청크/쿼리 임베딩.
#  어디로: 사내 임베딩 서버의 /v1 주소.
#          *_BASE_URL 예) http://embed.internal.corp:8000/v1
#          *_MODEL 은 사내 임베딩 모델명으로.
#  안 바꾸면: 적재·검색 임베딩 실패(빈 벡터/검색 0건).
LITELLM_EMBEDDING_BASE_URL=https://litellm.ax-demo.com/v1
LITELLM_EMBEDDING_API_KEY=
EDGEQUAKE_EMBEDDING_MODEL=bge-m3
ADAPTIVE_CHUNK_SCORING_EMBEDDING_BASE_URL=https://litellm.ax-demo.com/v1
ADAPTIVE_CHUNK_SCORING_EMBEDDING_API_KEY=
ADAPTIVE_CHUNK_SCORING_EMBEDDING_MODEL=bge-m3

# ── A-4. 리랭커 (검색 재정렬, Qwen3-Reranker-0.6B) ────────────────────────────
#  무엇: 검색 후보 재정렬(BM25 동의어 컷 보완).
#  어디로: 사내 리랭커 엔드포인트.
#          - edgequake 는 /rerank 전체 경로: 예) http://rerank.internal.corp:8000/v1/rerank
#          - adaptive_chunk 는 /v1 base:    예) http://rerank.internal.corp:8000/v1
#  안 바꾸면: 리랭킹 실패 → BM25 폴백(검색 품질 저하, 치명은 아님).
EDGEQUAKE_RERANK_BASE_URL=https://litellm.ax-demo.com/v1/rerank
EDGEQUAKE_RERANK_MODEL=Qwen3-Reranker-0.6B
EDGEQUAKE_RERANK_API_KEY=
ADAPTIVE_CHUNK_RERANK_BASE_URL=https://litellm.ax-demo.com/v1
ADAPTIVE_CHUNK_RERANK_MODEL=Qwen3-Reranker-0.6B
ADAPTIVE_CHUNK_RERANK_API_KEY=


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 【B. 내부 전용】 — 스택 내부 값. 원칙적으로 바꾸지 말 것                        │
# │  (인트라스택 DNS·컨테이너 자격증명. 외부 서비스로 나가지 않는다.)              │
# └─────────────────────────────────────────────────────────────────────────────┘

# ── B-1. MinIO (페이지 이미지 저장, 스택 내장) ────────────────────────────────
#  ACCESS/SECRET 는 원하는 값으로 설정(내장 MinIO 의 root 자격증명이 됨).
#  이미 사내에 별도 MinIO 가 있어 그걸 쓰려면 docs/airgap-deploy.md §부록A 참고
#  (minio 서비스 블록 삭제 + MINIO_ENDPOINT/SECURE 를 외부값으로).
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=miniopass
MINIO_BUCKET=document-parser
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# ── B-2. Postgres (edgequake 그래프 DB, 스택 내장) ────────────────────────────
POSTGRES_PASSWORD=edgequake_secret

# ── B-3. 인트라스택 DNS / 튜닝 (건드릴 일 거의 없음) ──────────────────────────
ADAPTIVE_CHUNK_EDGEQUAKE_BASE_URL=http://edgequake:8081
ADAPTIVE_CHUNK_SCORING_EMBEDDING_TIMEOUT_S=600
ADAPTIVE_CHUNK_JOB_TIMEOUT_S=3600
ADAPTIVE_CHUNK_COREF_REASONING=off
ADAPTIVE_CHUNK_COREF_MAX_TOKENS=2000
EQ_RUST_LOG=info

# ── B-4. edgequake WebUI (그래프 적재 확인용, 선택) ───────────────────────────
#  브라우저가 edgequake API 에 닿는 URL. ⚠️ edgequake API 호스트포트가 3001 로 노출되므로
#  이 값의 포트도 3001 이어야 한다(컨테이너 내부 8081 아님). 원격 PC 접속 시 서버 IP 로 변경.
#  예) http://10.0.0.5:3001
EDGEQUAKE_WEBUI_API_URL=http://localhost:3001

# ── B-5. VL(스캔 PDF 그림·차트 해석) ─────────────────────────────────────────
#  온프렘 서빙 모델명. **필수** — 미지정이면 compose 가 기동을 막는다.
#  실측 근거(R2~R7)는 qwen/qwen3.5-122b-a10b 로 잰 값이다. 다른 모델로 바꾸면 그 근거가 무효.
MODEL_NAME=qwen/qwen3.5-122b-a10b
#  전면 VL 은 본문·표·서술을 한 응답에 담는다. 2000 에서는 절단이 정상 동작이 된다.
VL_MAX_TOKENS=8000
KBP_VL_PAGE_MAX_TOKENS=8000
#  hybrid VL 입력 해상도. 실측이 전부 200dpi 라 그 값과 일치시킨다.
KBP_VL_PAGE_DPI=200
#  image/figure/chart 가 페이지의 이 비율 이상일 때만 전면 VL(실측 공백 0.55~5.06%).
KBP_VL_VISUAL_MIN_AREA=0.05
#
#  ⚠ 폐쇄망 주의: payload 의 `provider.ignore` 와 `reasoning` 은 **OpenRouter 전용**이라
#  자체 서빙에서는 무효 필드다. KBP_VL_BLOCK_PROVIDERS 는 compose 가 빈 문자열로 고정한다
#  (키를 빼면 코드 기본값 DeepInfra 가 발동해 온프렘 서버로 전송된다).
#  또한 reasoning 계열 모델은 서빙 측에서 thinking 을 꺼야 한다 — 켜져 있으면 thinking 토큰이
#  max_tokens 를 잠식해 JSON 이 절단되고, 파서가 그것을 실패로 잡아 기능이 조용히 무효화된다.

# ── 파일 변환 API (docs/API_FILECONVERT_AGENT.md) ─────────────────────────────
# URL 은 **경로 접두사까지** 포함한다. 호스트만 넣으면 404 로 조용히 실패한다.
#   예: http://<host>/api/fileconvert/agent/tool
# 기본값을 주지 않는다 — 미설정이면 즉시 실패한다(운영이 개발 서버로 새는 것 방지).
KBP_FILECONVERT_URL=
KBP_FILECONVERT_TOKEN=
KBP_FILECONVERT_TIMEOUT=300
KBP_FILECONVERT_CRT_ID=kb-pipeline

# ── DRM 해제 API (docs/REFERENCE_DRM해제_API.md) ──────────────────────────────
# ⚠️ **사내 문서에 DRM(Fasoo)이 걸려 있다면 반드시 채워야 한다.**
#    비워두면 DRM 문서가 **전부 파싱 실패**한다:
#      → facade 응답 detail = "parse_failed: KBP_DRM_URL 미설정 — DRM 해제 불가"
#    실측 2026-08-07: 실제 업무 PDF(자금집행 요청서)가 Fasoo DRM 래핑이라 이 이유로 실패했다.
#    DRM 문서를 안 다루면 비워둬도 된다(비-DRM 파일은 이 경로를 아예 타지 않는다).
# 파일변환과 같은 인프라지만 **path prefix 가 다르다** — 예: http://<host>/api/drm/agent/tool
# (KBP_FILECONVERT_URL 이 .../api/fileconvert/agent/tool 이면 fileconvert→drm 만 바꾼 주소)
# 토큰은 별도 변수다(서버가 나중에 분리될 수 있음). 값은 우선 KBP_FILECONVERT_TOKEN 과 동일하게.
KBP_DRM_URL=
KBP_DRM_TOKEN=
KBP_DRM_TIMEOUT=300

# ── PDF 트리아제 임계치 (parse_service/parsers/pdf/triage.py, 2026-08-06) ──────
# 이미지 파서 고도화 준비 — 값을 바꾸면 소스 수정 없이 페이지 분류 임계치가 바뀐다.
# 미설정 시 기존 하드코딩 값과 100% 동일(회귀 0).
KBP_TRIAGE_MIXED_IMAGE_COV=0.25
KBP_TRIAGE_CONTENT_MIN=300
KBP_TRIAGE_DIAGRAM_CURVE_MIN=30
KBP_TRIAGE_DIAGRAM_LINE_MIN=100
KBP_TRIAGE_DIAGRAM_IMG_COUNT=5
KBP_TRIAGE_DIAGRAM_COMBO_CURVE_MIN=10
KBP_TRIAGE_NATIVE_TEXT_MIN_CHARS=20
# 가로형 페이지(width>height) → 묻고 따질 것 없이 LLM_NEEDED(VL). 0 이면 이 규칙을 끈다.
KBP_TRIAGE_LANDSCAPE_TO_LLM=1

# ── PDF 게이트 — 레인 선택 (parse_service/parsers/pdf/gate.py, 2026-08-06) ─────
# 값은 odl|vl|paddle_gw 중 하나만 유효(그 외는 경고 로그 + 기본값 폴백).
KBP_GATE_VL_RATIO=0.5
KBP_GATE_VL_LANE=vl
KBP_GATE_OCR_LANE=paddle_gw
KBP_GATE_DEFAULT_LANE=odl

# ── PDF 트리아제 페이지별 판정 로그 on/off (2026-08-06) ────────────────────────
# 0 이면 완전히 스킵(대량 처리 시 로그 폭주 억제).
KBP_TRIAGE_LOG_TABLE=1

# ── VL PAGE_HYBRID 프롬프트 — 순서도 조항 오버라이드 (parse_service/parsers/ocr/prompts.py, 2026-08-06) ──
# PAGE_HYBRID 프롬프트의 순서도 조항 전체를 교체(선택, 비워두면 코드 기본값 — 박스 안
# 라벨을 원문 그대로 보존하며 흐름을 서술하는 규칙 — 사용). dotenv 는 여러 줄 값을 지원하지
# 않으므로 **줄바꿈 없이 한 줄**로 적는다(모델은 프롬프트 줄바꿈 여부에 개의치 않는다).
KBP_PAGE_HYBRID_DIAGRAM_RULE=
# VL 프롬프트 — 계층구조(헤딩#/표 병합셀 colspan·rowspan/도형 상하위·단계) 규칙 전체를
# 교체(선택, 비워두면 코드 기본값). 실측 2026-08-07: 미적용 시 VL 이 마크다운 헤딩을
# 33/33 페이지에서 전혀 안 내 RAG 청킹 시 장·절 계층이 사라졌다. 한 줄로 적는다.
KBP_PROMPT_HIERARCHY_RULE=

# ── 야간 커뮤니티 배치 (A1) ───────────────────────────────────────────────────
# 커뮤니티 빌드를 적재 경로에서 떼어내 밤 1회로 모은다(주간 LLM 부하 회피 + 진입점 단일화).
# 대가: 커뮤니티가 **최대 하루** 뒤 반영된다. 즉시 필요하면 POST /communities/build.
# ⚠️ TZ 를 안 주면 컨테이너는 UTC 라 03:00 이 **KST 12:00** 에 열려 목적이 뒤집힌다.
TZ=Asia/Seoul
KBP_COMMUNITY_BUILD_ENABLED=true
KBP_COMMUNITY_BUILD_AT=03:00
KBP_COMMUNITY_WINDOW_MINUTES=120
# 이 시각 이후 남은 queued 를 취소한다(업무시간 침범 방지). 창보다 커야 의미가 있다.
# ⚠️ 이미 실행 중(running)인 빌드는 자르지 않는다 — LLM 호출을 되돌릴 수 없어 작업만 버린다.
KBP_COMMUNITY_DEADLINE_MINUTES=420
KBP_COMMUNITY_MAX_PER_NIGHT=8
KBP_COMMUNITY_POLL_SECONDS=60
# SIGKILL/OOM 으로 실행 이력이 'started' 로 굳었을 때 회수하기까지의 지연(분).
KBP_COMMUNITY_STALE_RUN_MINUTES=30
# 제출 루프 시간 예산(초). edgequake 가 hang 이면 틱 하나가 오래 막히는 것을 끊는다.
KBP_COMMUNITY_SUBMIT_BUDGET_SECONDS=600
