# 8.kb-pipeline/.env.airgap.example — 폐쇄망(air-gap) 배포용 환경변수 템플릿
# ═══════════════════════════════════════════════════════════════════════════════
# 사용법: 이 파일을 `.env` 로 복사한 뒤, 아래 【A. 온프렘 재설정 필수】 블록의
#         주소/키만 사내 엔드포인트로 바꾼다.
#             cp .env.airgap.example .env  &&  vi .env
#         【B. 내부 전용】 블록은 원칙적으로 건드리지 않는다.
#         모든 시크릿은 빈 값이다 — 반드시 실제 값으로 채워야 스택이 정상 기동한다.
#
# ⚠️ 규칙: 값 뒤에 인라인 주석(`KEY=값   # ...`)을 붙이지 말 것.
#          podman-compose 는 인라인 주석을 걷어내지 않아 그 `# ...` 가 값에 섞인다.
#          설명은 반드시 이렇게 '독립 라인'(`#` 으로 시작)에만 둔다.
# ═══════════════════════════════════════════════════════════════════════════════


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 【A. 온프렘 재설정 필수】 — 폐쇄망에서 도달 가능한 사내 주소/키로 바꿀 것        │
# │  ⚠️ 아래 BASE_URL 기본값은 전부 인터넷(OpenRouter/litellm.ax-demo.com)이라      │
# │     폐쇄망에서 불통이다. 반드시 사내 주소로 교체한다.                           │
# └─────────────────────────────────────────────────────────────────────────────┘

# ── A-1. LLM (그래프추출·facade·parse-svc·adaptive_chunk regex/coref) ──────────
#  무엇: 지식그래프 엔티티/관계 추출 + 답변합성 + 청킹 정규식/상호참조 LLM.
#  어디로: 사내 OpenAI 호환 LLM 게이트웨이(vLLM/litellm 등)의 /v1 주소.
#          *_BASE_URL 예) http://llm.internal.corp:8000/v1
#          *_LLM_MODEL 은 사내에서 실제 서빙하는 모델명으로.
#  안 바꾸면: edgequake 그래프추출·검색합성 타임아웃/실패, 청킹 스톨.
# ── A-0. facade 공유비밀 (X-Facade-Key) ───────────────────────────────────────
#  무엇: facade 의 상태변경 엔드포인트(/ingest·/insert·/search·/chunks·/doc·/jobs·
#        /gate·/objects)를 여는 공유비밀. **kb 스택의 KBP_FACADE_KEY 와 같은 값**이어야
#        적재·검색이 통과한다.
#  안 채우면: 게이트가 꺼진 채 기동한다(dev 와 동일 동작). 폐쇄망에서 facade 는 호스트
#        3000 포트로 노출되므로, 비워두면 **무인증으로 적재·검색·삭제가 열린다.**
#        verify-bundle.sh 가 배포 전에 막는다.
#  만들기: openssl rand -hex 32
KBP_FACADE_KEY=

# edgequake(그래프/벡터 엔진)의 LLM provider — 기본 openai-compatible(위 KBP_OPENAI_*
# 재사용, docker-compose.airgap.yml 의 OPENAI_COMPATIBLE_* 로 배선됨). 폐쇄망 실측
# (2026-08-07, 2단계):
#  1) openrouter provider 는 base_url 오버라이드가 없어 인터넷 없는 환경에서 100%
#     실패한다(하드코딩 https://openrouter.ai).
#  2) provider=openai 로 바꿔도 COMPAT-GUARD(safety_limits.rs)가 "openai"+비-gpt-*
#     모델명(예: qwen/...)을 감지해 gpt-4.1-nano/api.openai.com 으로 조용히 되돌린다.
#     openai-compatible 은 이 가드 대상이 아니라(코드 확인) 커스텀 모델명이 그대로 간다.
# 인터넷이 되는 환경에서만 openrouter 로 바꾼다.
EDGEQUAKE_LLM_PROVIDER=openai-compatible
OPENROUTER_API_KEY=
KBP_OPENAI_API_KEY=
KBP_OPENAI_BASE_URL=https://openrouter.ai/api/v1
KBP_LLM_MODEL=qwen/qwen3.5-122b-a10b
ADAPTIVE_CHUNK_OPENROUTER_API_KEY=
ADAPTIVE_CHUNK_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ADAPTIVE_CHUNK_REGEX_LLM_MODEL=qwen/qwen3.5-122b-a10b
ADAPTIVE_CHUNK_COREF_LLM_MODEL=qwen/qwen3.5-122b-a10b

# ── A-2. VL-OCR (parse-svc in-process 이미지/PPTX/스캔 파싱) ───────────────────
#  무엇: 이미지·스캔·PPTX 페이지를 텍스트로 푸는 비전-언어(VL) 모델.
#  어디로: 사내 VL 모델의 chat/completions 전체 경로.
#          MODEL_API_URL 예) http://vl.internal.corp:8000/v1/chat/completions
#  안 바꾸면: 이미지/PPTX/스캔 파싱 시 enriched_content 가 비어 적재 누락.
MODEL_API_URL=https://openrouter.ai/api/v1/chat/completions
MODEL_API_KEY=

# ── A-3. 임베딩 (edgequake 벡터화 + adaptive_chunk 스코어링, bge-m3, 1024차원) ──
#  무엇: 청크/쿼리 임베딩.
#  어디로: 사내 임베딩 서버의 /v1 주소.
#          *_BASE_URL 예) http://embed.internal.corp:8000/v1
#          *_MODEL 은 사내 임베딩 모델명으로.
#  안 바꾸면: 적재·검색 임베딩 실패(빈 벡터/검색 0건).
LITELLM_EMBEDDING_BASE_URL=https://litellm.ax-demo.com/v1
LITELLM_EMBEDDING_API_KEY=
EDGEQUAKE_EMBEDDING_MODEL=bge-m3
ADAPTIVE_CHUNK_SCORING_EMBEDDING_BASE_URL=https://litellm.ax-demo.com/v1
ADAPTIVE_CHUNK_SCORING_EMBEDDING_API_KEY=
ADAPTIVE_CHUNK_SCORING_EMBEDDING_MODEL=bge-m3

# ── A-4. 리랭커 (검색 재정렬, Qwen3-Reranker-0.6B) ────────────────────────────
#  무엇: 검색 후보 재정렬(BM25 동의어 컷 보완).
#  어디로: 사내 리랭커 엔드포인트.
#          - edgequake 는 /rerank 전체 경로: 예) http://rerank.internal.corp:8000/v1/rerank
#          - adaptive_chunk 는 /v1 base:    예) http://rerank.internal.corp:8000/v1
#  안 바꾸면: 리랭킹 실패 → BM25 폴백(검색 품질 저하, 치명은 아님).
EDGEQUAKE_RERANK_BASE_URL=https://litellm.ax-demo.com/v1/rerank
EDGEQUAKE_RERANK_MODEL=Qwen3-Reranker-0.6B
EDGEQUAKE_RERANK_API_KEY=
ADAPTIVE_CHUNK_RERANK_BASE_URL=https://litellm.ax-demo.com/v1
ADAPTIVE_CHUNK_RERANK_MODEL=Qwen3-Reranker-0.6B
ADAPTIVE_CHUNK_RERANK_API_KEY=


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 【B. 내부 전용】 — 스택 내부 값. 원칙적으로 바꾸지 말 것                        │
# │  (인트라스택 DNS·컨테이너 자격증명. 외부 서비스로 나가지 않는다.)              │
# └─────────────────────────────────────────────────────────────────────────────┘

# ── B-1. MinIO (페이지 이미지 저장, 스택 내장) ────────────────────────────────
#  ACCESS/SECRET 는 원하는 값으로 설정(내장 MinIO 의 root 자격증명이 됨).
#  이미 사내에 별도 MinIO 가 있어 그걸 쓰려면 docs/airgap-deploy.md §부록A 참고
#  (minio 서비스 블록 삭제 + MINIO_ENDPOINT/SECURE 를 외부값으로).
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=miniopass
MINIO_BUCKET=document-parser
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# ── B-2. Postgres (edgequake 그래프 DB, 스택 내장) ────────────────────────────
POSTGRES_PASSWORD=edgequake_secret

# ── B-3. 인트라스택 DNS / 튜닝 (건드릴 일 거의 없음) ──────────────────────────
ADAPTIVE_CHUNK_EDGEQUAKE_BASE_URL=http://edgequake:8081
ADAPTIVE_CHUNK_SCORING_EMBEDDING_TIMEOUT_S=600
ADAPTIVE_CHUNK_JOB_TIMEOUT_S=3600
ADAPTIVE_CHUNK_COREF_REASONING=off
ADAPTIVE_CHUNK_COREF_MAX_TOKENS=2000
EQ_RUST_LOG=info

# ── B-3b. 튜닝 노브 (기본값 = 기존 동작. 필요할 때만 건드린다) ────────────────
# 리랭크 점수 하드컷. 0.0 = 재정렬만 하고 후보를 버리지 않는다.
# ⚠️ 올리면 정답이 잘릴 수 있다 — 과거 0.1 이 "이사"→"거주지 이전시" 검색을 실패시켰다.
EDGEQUAKE_MIN_RERANK_SCORE=0.0
# reasoning(thinking) 끄기. 1=끔.
# 켜두면 thinking 토큰이 max_tokens 를 잠식해 JSON 이 절단되고, 파서가 그걸 실패로
# 처리해 엔티티 추출이 **조용히 무효화**된다. 사내 모델이 thinking 을 안 쓰면 무관.
EDGEQUAKE_LLM_DISABLE_REASONING=1
# 구조화출력 방식. 사내 LLM 게이트웨이가 response_format 을 못 받으면 바꾼다.
GUIDED_JSON_MODE=response_format


# ── B-6. 잡 큐 / 배치 처리량 튜닝 ────────────────────────────────────────────
# 값은 전부 compose 기본값과 동일하다 — 그대로 두면 동작 변화 없음.
# 대량 배치 적재 시 여기서 처리량을 조절한다(서버 코어수·메모리에 맞춰).

# 동시 파싱 잡 수. 파싱은 CPU 바운드라 코어수 기준으로 올린다.
KBP_JOB_LIMIT_PARSE=4
# facade-worker 프로세스의 동시 처리 수.
KBP_JOB_WORKER_CONCURRENCY=4
# 한 워크스페이스가 동시 점유할 수 있는 잡 수(한 KB 독점 방지).
KBP_JOB_LIMIT_PER_WORKSPACE=2
# 동기 호출(/parse 등)이 결과를 기다릴 수 있는 최대 대기자 수.
KBP_JOB_MAX_WAITERS=4
# 동기 호출 대기 시한(초). Dockerfile 의 gunicorn --timeout(4200)보다 작아야 한다.
KBP_JOB_LEGACY_WAIT_SECONDS=3300
# 업로드 최대 크기(바이트). 기본 50MB.
KBP_JOB_MAX_UPLOAD_BYTES=52428800
# 동시 청킹 잡 수.
KBP_JOB_LIMIT_CHUNK=2
# 동시 적재 잡 수.
KBP_JOB_LIMIT_INSERT=2
# 커뮤니티 재빌드 동시성. 전역 단일 그래프라 1 로 충분하다.
KBP_JOB_LIMIT_COMMUNITY=1
# 잡 payload/result 오프로딩 프리픽스.
KBP_JOB_MINIO_PREFIX=kbp-jobs
# kb 가 남긴 임시본 프리픽스.
KBP_STAGING_PREFIX=parse-staging
# 미리보기 임시본 TTL(초).
KBP_STAGING_TTL_SECONDS=3600
# 배치 원본 TTL(초). 실패항목 재수행이 이 객체를 다시 쓰므로 길게. 기본 7일.
KBP_STAGING_BATCH_TTL_SECONDS=604800
# 잡 레코드 TTL(시간). ⚠️ 0 이면 TTL 삭제와 고아 스윕이 **둘 다 정지**한다(비상 레버).
KBP_JOB_TTL_HOURS=72
# GC 주기(초).
KBP_JOB_GC_INTERVAL_SECONDS=3600
# 고아 오브젝트 스윕 주기(초).
KBP_JOB_ORPHAN_SWEEP_INTERVAL_SECONDS=21600
# 기동 후 첫 스윕까지 지연(초).
KBP_JOB_ORPHAN_SWEEP_BOOT_DELAY_SECONDS=600
# 고아 판정 유예(초). 진행 중 잡을 지우지 않기 위함.
KBP_JOB_ORPHAN_GRACE_SECONDS=21600

# ── B-4. edgequake WebUI (그래프 적재 확인용, 선택) ───────────────────────────
#  브라우저가 edgequake API 에 닿는 URL. ⚠️ edgequake API 호스트포트가 3001 로 노출되므로
#  이 값의 포트도 3001 이어야 한다(컨테이너 내부 8081 아님). 원격 PC 접속 시 서버 IP 로 변경.
#  예) http://10.0.0.5:3001
EDGEQUAKE_WEBUI_API_URL=http://localhost:3001

# ── B-5. VL(스캔 PDF 그림·차트 해석) ─────────────────────────────────────────
#  온프렘 서빙 모델명. **필수** — 미지정이면 compose 가 기동을 막는다.
#  실측 근거(R2~R7)는 qwen/qwen3.5-122b-a10b 로 잰 값이다. 다른 모델로 바꾸면 그 근거가 무효.
MODEL_NAME=qwen/qwen3.5-122b-a10b
#  전면 VL 은 본문·표·서술을 한 응답에 담는다. 2000 에서는 절단이 정상 동작이 된다.
VL_MAX_TOKENS=8000
KBP_VL_PAGE_MAX_TOKENS=8000
# ── VL 실패 정책 (Phase 2b-2, 2026-08-14) ──────────────────────────────────
# VL 이 끝내 아무것도 못 낸 페이지가 있으면 **문서 파싱을 실패**시킨다.
# 폴백(네이티브 텍스트·ODL 마크다운)은 제거됐다 — 122b 가 아픈데 다른 출처로
# 조용히 채워지면 열화를 볼 방법이 없기 때문이다.
KBP_VL_PAGE_ATTEMPTS=2          # 총 VL 호출 횟수(최초 1 + 재시도 1). 1~5 로 클램프
#   절단·에러플레이스홀더(A형)만 **+1회**를 더 받는다(기본 2 → 3). 원인이 모델 퇴화가
#   아니라 프로바이더 사정일 수 있어 재호출에서 살아나기 때문. 별도 env 없이 파생된다.
KBP_VL_DOC_BUDGET_S=3600        # 문서당 VL 총예산(초). 초과 시 남은 재시도 포기
# ⚠️ 탈출구. 0 으로 끄면 VL 실패 페이지가 **빈 본문으로 적재**된다. 아래 폴백 체인이
#    켜져 있으면 그쪽이 먼저 채우므로, 여기까지 오는 것은 "체인을 다 소진한" 페이지뿐이다.
KBP_FAIL_ON_EMPTY_PAGE=1

# ── VL 폴백 체인 (2026-08-14) ────────────────────────────────────────────────
# VL 실패 → pw(게이트웨이) → odl(md) → rp.text(네이티브) → 빈 페이지.
# **이미 거친 레인은 건너뛴다** — paddle_gw 출신은 pw 를, odl 출신은 odl 을 skip.
# 발동하면 page_traces 의 source 가 gw_fallback / vl_md_fallback / native_fallback 으로
# 남고 counters.fallback_* 로 세어진다 — 조용히 가려지지 않는다.
#
# 근거(실측 2026-08-14): 전량 VL 문서가 프로바이더 절단으로 **간헐 40% 실패**했고
# 재시도 비대칭(절단 +1회)으로도 못 살렸다. 문서 결함이 아니라 프로바이더 사정이라
# 같은 파일이 재실행에서 통과한다.
#
# 0 = 끔 → 2b-2 동작 그대로(VL 실패 = 문서 실패). **품질을 낮추지 않는다** —
#          다른 출처로 채우지 않으므로 열화가 가려지지 않고 그대로 드러난다.
KBP_VL_FALLBACK_CHAIN=1
# 체인의 pw 단계로 보낼 최대 페이지 수. 상한이 없으면 최악(트리아지+ODL 동시 실패)에
# 전 페이지가 게이트웨이로 가고, 페이지당 poll 시한이 600초라(코드 상수) facade 가
# ReadTimeout 으로 문서를 죽인다.
KBP_VL_FALLBACK_GW_MAX_PAGES=10

#  hybrid VL 입력 해상도. 실측이 전부 200dpi 라 그 값과 일치시킨다.
KBP_VL_PAGE_DPI=200
#  image/figure/chart 가 페이지의 이 비율 이상일 때만 전면 VL(실측 공백 0.55~5.06%).
KBP_VL_VISUAL_MIN_AREA=0.05
#
#  ⚠ 폐쇄망 주의: payload 의 `provider.ignore` 와 `reasoning` 은 **OpenRouter 전용**이라
#  자체 서빙에서는 무효 필드다. KBP_VL_BLOCK_PROVIDERS 는 compose 가 `none` 으로 고정한다
#  (키를 빼면 코드 기본값 DeepInfra 가 발동해 온프렘 서버로 전송된다).
#  또한 reasoning 계열 모델은 서빙 측에서 thinking 을 꺼야 한다 — 켜져 있으면 thinking 토큰이
#  max_tokens 를 잠식해 JSON 이 절단되고, 파서가 그것을 실패로 잡아 기능이 조용히 무효화된다.

# ── 파일 변환 API (docs/API_FILECONVERT_AGENT.md) ─────────────────────────────
# URL 은 **경로 접두사까지** 포함한다. 호스트만 넣으면 404 로 조용히 실패한다.
#   예: http://<host>/api/fileconvert/agent/tool
# 기본값을 주지 않는다 — 미설정이면 즉시 실패한다(운영이 개발 서버로 새는 것 방지).
KBP_FILECONVERT_URL=
KBP_FILECONVERT_TOKEN=
KBP_FILECONVERT_TIMEOUT=300
KBP_FILECONVERT_CRT_ID=kb-pipeline

# ── DRM 해제 API (docs/REFERENCE_DRM해제_API.md) ──────────────────────────────
# ⚠️ **사내 문서에 DRM(Fasoo)이 걸려 있다면 반드시 채워야 한다.**
#    비워두면 DRM 문서가 **전부 파싱 실패**한다:
#      → facade 응답 detail = "parse_failed: KBP_DRM_URL 미설정 — DRM 해제 불가"
#    실측 2026-08-07: 실제 업무 PDF(자금집행 요청서)가 Fasoo DRM 래핑이라 이 이유로 실패했다.
#    DRM 문서를 안 다루면 비워둬도 된다(비-DRM 파일은 이 경로를 아예 타지 않는다).
# 파일변환과 같은 인프라지만 **path prefix 가 다르다** — 예: http://<host>/api/drm/agent/tool
# (KBP_FILECONVERT_URL 이 .../api/fileconvert/agent/tool 이면 fileconvert→drm 만 바꾼 주소)
# 토큰은 별도 변수다(서버가 나중에 분리될 수 있음). 값은 우선 KBP_FILECONVERT_TOKEN 과 동일하게.
KBP_DRM_URL=
KBP_DRM_TOKEN=
KBP_DRM_TIMEOUT=300

# ── PDF 트리아제 임계치 (parse_service/parsers/pdf/triage.py, 2026-08-06) ──────
# 이미지 파서 고도화 준비 — 값을 바꾸면 소스 수정 없이 페이지 분류 임계치가 바뀐다.
# 미설정 시 기존 하드코딩 값과 100% 동일(회귀 0).
KBP_TRIAGE_MIXED_IMAGE_COV=0.25
KBP_TRIAGE_CONTENT_MIN=300
KBP_TRIAGE_DIAGRAM_CURVE_MIN=30
KBP_TRIAGE_DIAGRAM_LINE_MIN=100
KBP_TRIAGE_DIAGRAM_IMG_COUNT=5
KBP_TRIAGE_DIAGRAM_COMBO_CURVE_MIN=10
KBP_TRIAGE_NATIVE_TEXT_MIN_CHARS=100
# 가로형 페이지(width>height) → 묻고 따질 것 없이 LLM_NEEDED(VL). 0 이면 이 규칙을 끈다.
KBP_TRIAGE_LANDSCAPE_TO_LLM=1

# ── PDF 게이트 — 레인 선택 (parse_service/parsers/pdf/gate.py, 2026-08-06) ─────
# 값은 odl|vl|paddle_gw 중 하나만 유효(그 외는 경고 로그 + 기본값 폴백).
# ⚠️ 무효(2026-08-12) — 페이지수준 라우팅 도입으로 **소비자가 사라졌다**.
#    문서수준 `vl` 레인이 없어져 값을 바꿔도 아무 일도 안 일어난다.
#    선언만 남긴 이유: 지우지도 설명하지도 않으면 다음 사람이 값을 바꿔보고
#    아무 변화가 없는 것을 겪는다. 삭제는 Phase 4(현장 .env 마이그레이션 동반).
KBP_GATE_VL_RATIO=0.5
KBP_GATE_VL_LANE=vl
KBP_GATE_OCR_LANE=paddle_gw

# ── VL 프로바이더 차단 (parse_service/parsers/ocr/vl_api.py) ──
# OpenRouter 전용 필드라 **자체 서빙에서는 무의미**하다. 끄기는 `none` 센티널을 쓴다 —
# 빈 값은 sync-parse-svc-env.sh 가 통째로 버려 키가 안 실리고 코드 기본값(DeepInfra)이
# 부활한다. ⚠️ airgap compose 는 값을 하드코딩하므로 컨테이너 경로엔 실효가 없다 —
# 이 값은 호스트/parse-only 경로용이다.
KBP_VL_BLOCK_PROVIDERS=none


# ── paddle_gw 페이지 게이트 (parse_service/parsers/pdf/page_verdict.py, 2026-08-11) ──
# GW 출력이 **확실히 붕괴한 페이지만** quarantine 한다(색인 제외 + 사유 보존).
# 애매하면 보존이 원칙 — false quarantine 보다 silent deletion 이 더 나쁘다.
# 값에 인라인 주석을 붙이지 말 것(순진한 파서가 주석까지 값으로 읽는다).
#
# KBP_GW_GATE                0 = 게이트 전체 off (탈출구)
# KBP_GW_MIN_CHARS           이보다 적으면 EMPTY 후보
# KBP_GW_BLANK_INK_MAX       잉크가 이 미만이면 '원래 빈 페이지'(실패 아님, 색인 유지)
# KBP_GW_CJK_MIN             한자 오염 판정 하한(자)
# KBP_GW_CJK_RATIO           한자/(한자+한글) 비율
# KBP_GW_CJK_DOC_RATIO       문서의 이 비율 이상이 한자오염이면 '한자 문서'로 보고 되돌림
# KBP_GW_CJK_DOC_MIN_PAGES   위 문서 가드의 최소 페이지 수(1~2p 문서 자기무력화 방지)
# KBP_GW_DEGEN_SURVIVE_RATIO 퇴화 제거 후 잔존율이 이 미만이면 붕괴
# KBP_GW_DEGEN_MIN_CHARS     원문이 이보다 짧으면 붕괴 판정 안 함(짧은 페이지 증폭 방지)
KBP_GW_GATE=1
KBP_GW_MIN_CHARS=50
KBP_GW_BLANK_INK_MAX=0.05
KBP_GW_CJK_MIN=30
KBP_GW_CJK_RATIO=0.50
KBP_GW_CJK_DOC_RATIO=0.30
KBP_GW_CJK_DOC_MIN_PAGES=3
KBP_GW_DEGEN_SURVIVE_RATIO=0.5
KBP_GW_DEGEN_MIN_CHARS=500

# ── 퇴화 필터 (parse_service/parsers/degen_filter.py) — 전 레인 영향 ──
# KBP_DEGEN_COMPRESS_MAX  표 R1 압축비 임계(텍스트 T1 은 무변경)
# KBP_DEGEN_SOFT_RULES    SOFT 로 강등할 규칙. `none` 이면 전 규칙 HARD = 구동작 복원.
#                         ⚠️ 빈 값은 센티널이 아니다 — 미설정과 같이 기본값(R3,R4)이 된다.
KBP_DEGEN_COMPRESS_MAX=0.16
KBP_DEGEN_SOFT_RULES=R3,R4

# ── 이미지 경로 누출 방지 (paddle_gw gw2 + ODL 이미지 필터, 2026-08-17) ──
# paddle_gw: 대형 이미지(≥KBP_VL_VISUAL_MIN_AREA)는 없지만 image/figure/chart/header_image/
# footer_image 라벨 블록이 있으면 그 페이지만 use_ocr_for_image_block+use_chart_recognition
# 옵션으로 재호출(gw2). 게이트웨이가 없는 폐쇄망(KBP_GATE_OCR_LANE=vl)이면 paddle_gw 자체가
# 안 쓰여 자연히 no-op. 탈출구 겸 회귀 스위치 — 0이면 gw2 비활성(구 동작).
KBP_GW_IMAGE_OCR_ENABLE=1
# ODL(TEXT_ONLY) 레인 — 이미지 참조 면적이 이 값 미달이면 장식으로 보고 지운다, 이상이면
# VL 요약으로 치환(MODEL_API_URL 재사용, 새 외부 의존 없음). 0.05는 위험(실측: 4.86%짜리
# 소송 증거 스크린샷이 장식으로 오분류될 뻔함) — 낮게 잡는다.
KBP_ODL_IMAGE_VL_MIN_AREA=0.01
# 이 이미지에 대한 요약 프롬프트(페이지 전사 PAGE_HYBRID 프롬프트와 다름). 비우면 코드
# 기본값(parse_service/parsers/pdf/odl_image_summary.py) 사용.
KBP_ODL_IMAGE_SUMMARY_PROMPT=
# ODL 페이지의 이미지 참조 개수가 이 값을 넘으면 개별 VL 요약 대신 그 페이지 전체를 전면
# VL 전사(vl 레인과 동일 경로)로 처리 — 개별 VL 호출 수를 줄인다.
KBP_ODL_IMAGE_COUNT_VL_ESCALATE=2

# ⚠️ 무효(2026-08-12) — 페이지수준 라우팅 도입으로 **소비자가 사라졌다**.
#    문서수준 `vl` 레인이 없어져 값을 바꿔도 아무 일도 안 일어난다.
#    선언만 남긴 이유: 지우지도 설명하지도 않으면 다음 사람이 값을 바꿔보고
#    아무 변화가 없는 것을 겪는다. 삭제는 Phase 4(현장 .env 마이그레이션 동반).
KBP_GATE_DEFAULT_LANE=odl

# ── 스캔 PDF OCR 게이트웨이 (paddle_gw 레인의 실제 처리기) ─────────────────────
# 위 KBP_GATE_OCR_LANE=paddle_gw 이면 **이 값이 반드시 있어야 한다.**
# 비어 있으면 parse_service/parsers/pdf/paddle_gw.py 가 RuntimeError 를 내고, 그걸
# 비치명으로 잡아 **조용히 ODL/VL 로 폴백한다** — 파싱은 "성공"으로 보이지만 스캔 레인은
# 한 번도 동작하지 않는다(에러가 겉으로 안 드러난다). 게이트웨이를 안 쓸 거면 위
# KBP_GATE_OCR_LANE 을 vl 로 바꿔 **명시적으로** 끈다.
#
# 계약: POST {URL}/tasks (multipart file + lang) → task_id, GET {URL}/tasks/{task_id} 로 폴링.
#       즉 이 값은 엔진 경로까지 포함한 베이스다(끝에 /tasks 를 붙이지 않는다).
#       엔진 교체는 마지막 경로만 바꾸면 된다(paddleocr_vl | dots | mineru_vlm 동일 계약).
#
# 주소 정하기 — 사내 ocr-gateway 컨테이너는 kbp compose 밖에 있어 **컨테이너 이름으로는
# 해석되지 않는다**(다른 네트워크). 아래 중 하나를 쓴다:
#   1) podman 호스트 우회(권장):  http://host.containers.internal:18081/ocr/paddleocr_vl
#   2) 서버 LAN IP 직접 지정:      http://10.x.x.x:18081/ocr/paddleocr_vl
#   3) ocr-gateway 를 kbp 네트워크에 붙인 뒤: http://ocr-gateway:18081/ocr/paddleocr_vl
# 확인:  podman exec -it kbp_parse-svc_1 curl -sS -o /dev/null -w '%{http_code}\n' <URL>/tasks
#        (405/422 면 도달 성공 — GET 을 안 받는 것뿐이다. 000/502 면 주소가 틀렸다.)
KBP_PADDLE_OCR_GATEWAY_URL=http://host.containers.internal:18081/ocr/paddleocr_vl

# OCR 언어. 게이트웨이가 lang 폼필드로 받는다.
KBP_PADDLE_GW_LANG=korean
# 페이지 렌더링 DPI. 올리면 정확도↑ 전송량·시간↑.
KBP_PADDLE_GW_DPI=150
# 문서 1건 전체 시한(초). 초과 시 그 문서는 폴백.
KBP_PADDLE_GW_TIMEOUT=600

# 레거시 .xls(BIFF) → .xlsx 변환 타임아웃(초). LibreOffice 가 이미지 안에서 수행한다.
# 실측 2026-08-13: 현장 .xls 239KB 가 호스트 맥 38s / 컨테이너 amd64 콜드 18s.
# 짧으면 정상 문서가 실패하고, 길면 손상 파일이 워커를 오래 점유한다(최악 = 워커수 × 이 값).
KBP_XLS_CONVERT_TIMEOUT=120
# 개별 HTTP 호출 시한(초). 비동기 task 방식이라 짧아도 된다.
KBP_PADDLE_GW_HTTP_TIMEOUT=60
# task 상태 폴링 간격(초).
KBP_PADDLE_GW_POLL_INTERVAL=5
# 게이트웨이로 동시에 보낼 페이지 수. 게이트웨이 처리량에 맞춘다(너무 높이면 밀린다).
# ⚠️ 변수명 주의 — paddle_gw 는 KBP_PADDLE_GW_MAX_CONCURRENT 가 아니라 이 값을 읽는다
# (paddle_gw.py:143, 기본 3). VL 레인과 공유하는 동시성 노브다.
# 코드/compose 기본값은 3 이지만 8 로 올려 쓴다(사용자 지정, 2026-08-09).
# 게이트웨이가 밀리면(타임아웃·5xx 증가) 낮춘다.
KBP_VL_MAX_CONCURRENT=8
# ⚠️ 빈 값으로 두지 마라 — 미설정과 정반대(reasoning 켬)로 동작한다(vl_api.py).
KBP_VL_DISABLE_REASONING=1

# ── PDF 트리아제 페이지별 판정 로그 on/off (2026-08-06) ────────────────────────
# 0 이면 완전히 스킵(대량 처리 시 로그 폭주 억제).
KBP_TRIAGE_LOG_TABLE=1

# ── VL PAGE_HYBRID 프롬프트 — 순서도 조항 오버라이드 (parse_service/parsers/ocr/prompts.py, 2026-08-06) ──
# PAGE_HYBRID 프롬프트의 순서도 조항 전체를 교체(선택, 비워두면 코드 기본값 — 박스 안
# 라벨을 원문 그대로 보존하며 흐름을 서술하는 규칙 — 사용). dotenv 는 여러 줄 값을 지원하지
# 않으므로 **줄바꿈 없이 한 줄**로 적는다(모델은 프롬프트 줄바꿈 여부에 개의치 않는다).
KBP_PAGE_HYBRID_DIAGRAM_RULE=
# VL 프롬프트 — 계층구조(헤딩#/표 병합셀 colspan·rowspan/도형 상하위·단계) 규칙 전체를
# 교체(선택, 비워두면 코드 기본값). 실측 2026-08-07: 미적용 시 VL 이 마크다운 헤딩을
# 33/33 페이지에서 전혀 안 내 RAG 청킹 시 장·절 계층이 사라졌다. 한 줄로 적는다.
KBP_PROMPT_HIERARCHY_RULE=

# ── global 검색 (B) ───────────────────────────────────────────────────────────
# 커뮤니티 리포트 map-reduce 검색. 사용자가 챗에서 **명시적으로 버튼을 눌러** 쓴다
# (자동 라우팅 없음 — 오분류하면 조문 원문을 못 주는 답이 나온다).
# 요청 하나가 (map 최대 5 + reduce 1) × 타임아웃 만큼 스레드를 점유한다.
KBP_GLOBAL_LLM_TIMEOUT=60
# 워커 4개를 합친 **시스템 전역** 동시 실행 상한(DB 카운터 + advisory lock).
# 상한 도달 시 큐잉하지 않고 즉시 503 을 낸다.
KBP_GLOBAL_SEARCH_CONCURRENCY=2

# ── 야간 커뮤니티 배치 (A1) ───────────────────────────────────────────────────
# 커뮤니티 빌드를 적재 경로에서 떼어내 밤 1회로 모은다(주간 LLM 부하 회피 + 진입점 단일화).
# 대가: 커뮤니티가 **최대 하루** 뒤 반영된다. 즉시 필요하면 POST /communities/build.
# 야간 창을 판정할 시간대. **컨테이너 TZ 가 아니다**(D33) — 컨테이너는 UTC 로 둬서
# parse-svc 와 로그 시각축을 통일하고, 창 판정만 이 값으로 한다. 한 변수로 겸하면
# 로그를 UTC 로 맞추려 TZ=UTC 로 둘 때 **창이 조용히 KST 정오로 이동**한다.
# 비워도 된다 — 기본값이 Asia/Seoul 이다.
KBP_COMMUNITY_TZ=Asia/Seoul
KBP_COMMUNITY_BUILD_ENABLED=true
KBP_COMMUNITY_BUILD_AT=03:00
KBP_COMMUNITY_WINDOW_MINUTES=120
# 이 시각 이후 남은 queued 를 취소한다(업무시간 침범 방지). 창보다 커야 의미가 있다.
# ⚠️ 이미 실행 중(running)인 빌드는 자르지 않는다 — LLM 호출을 되돌릴 수 없어 작업만 버린다.
KBP_COMMUNITY_DEADLINE_MINUTES=420
KBP_COMMUNITY_MAX_PER_NIGHT=8
KBP_COMMUNITY_POLL_SECONDS=60
# SIGKILL/OOM 으로 실행 이력이 'started' 로 굳었을 때 회수하기까지의 지연(분).
KBP_COMMUNITY_STALE_RUN_MINUTES=30
# 제출 루프 시간 예산(초). edgequake 가 hang 이면 틱 하나가 오래 막히는 것을 끊는다.
KBP_COMMUNITY_SUBMIT_BUDGET_SECONDS=600

# ── 포트 탈출구 / edgequake 주소 (P1 2026-08-10) ──────────────────────────────
# facade 호스트 포트. **호스트 dev 런처(scripts/run-facade.sh) 전용**이다 —
# compose facade 는 3000:19000 으로 발행하므로 compose 쪽 충돌은 docker-compose.yml 을 고친다.
# ⚠️ 이 값을 바꾸면 kb 쪽 짝 env 도 같이 줘야 한다:
#    kb .env 의 KB_PIPELINE_BASE_URL=http://localhost:<이 포트>
#    (안 주면 kb→facade 적재·게이트가 조용히 끊긴다.)
KBP_FACADE_PORT=3000
# 1 이면 edgequake 에 닿지 않을 때 facade 기동을 **중단**한다. 기본(미설정/0)은 경고만 —
# facade 는 edgequake 없이도 /parse·/chunk·/gate/*·/objects/* 를 처리하므로 하드스톱을
# 기본으로 두면 parse 전용 작업이나 edgequake 재빌드 중 재기동을 막는다.
KBP_REQUIRE_EDGEQUAKE=0
# (EDGEQUAKE_WEBUI_API_URL 은 위쪽에 이미 선언돼 있다 — 원격 PC 는 서버 IP:3001)
